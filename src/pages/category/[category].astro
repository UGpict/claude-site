---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE, categoryOf, thumbUrl } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const categories = [...new Set(posts.map((p) => categoryOf(p.id)))];
	return categories.map((category) => ({
		params: { category },
		props: {
			posts: posts
				.filter((p) => categoryOf(p.id) === category)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<Base
	title={`${category}の記事 | ${SITE_TITLE}`}
	description={`「${category}」カテゴリの記事一覧。`}
	shareTitle={SITE_TITLE}
	ogImage={`/thumb/_cat-${category}.webp`}
>
	<p class="crumb"><a href="/blog/">記事一覧</a> ／ カテゴリ</p>
	<h1 class="page-title">カテゴリ：{category}</h1>
	<p class="lead">「{category}」の記事が {posts.length} 件あります。</p>

	<ul class="list">
		{
			posts.map((post) => (
				<li>
					<a class="row" href={`/blog/${post.id}/`}>
						<div class="thumb">
							{post.data.heroImage ? (
								<Image src={post.data.heroImage} width={320} height={180} alt="" />
							) : (
								<img src={thumbUrl(post.id)} width="320" height="180" alt="" loading="lazy" />
							)}
						</div>
						<div class="body">
							<div class="meta">
								<span class="badge">{categoryOf(post.id)}</span>
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h2 class="title">{post.data.title}</h2>
							<p class="excerpt">{post.data.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.crumb {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 0 0 0.5rem;
	}
	.page-title {
		font-size: 1.8rem;
		margin-bottom: 0.3rem;
	}
	.lead {
		color: rgb(var(--gray));
		margin-bottom: 1.5rem;
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.row {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.25rem;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			border-color 0.15s ease;
	}
	.row:hover {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow);
		border-color: transparent;
	}
	.thumb {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: rgb(var(--gray-light));
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		margin: 0;
	}
	.body {
		padding: 1rem 1.25rem 1rem 0;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
		font-size: 0.82rem;
		color: rgb(var(--gray));
	}
	.badge {
		font-weight: 700;
		color: var(--accent-dark);
		background: rgba(35, 55, 255, 0.1);
		padding: 2px 10px;
		border-radius: 999px;
	}
	.title {
		font-size: 1.2rem;
		line-height: 1.4;
		color: rgb(var(--black));
		margin: 0 0 0.4rem;
	}
	.excerpt {
		font-size: 0.9rem;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
		margin: 0;
	}
	@media (max-width: 560px) {
		.row {
			grid-template-columns: 1fr;
		}
		.body {
			padding: 0 1.25rem 1.1rem;
		}
	}
</style>
