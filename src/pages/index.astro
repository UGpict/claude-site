---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE, categoryOf, thumbUrl } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// トップは featured 1 本＋最新 8 本まで。続きは記事一覧（ページ送り）へ。
const [featured, ...others] = posts;
const rest = others.slice(0, 8);
const hasMore = others.length > rest.length;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} ogImage="/thumb/_home.webp" wide>
	<section class="intro" aria-labelledby="home-title">
		<div class="intro-copy">
			<p class="eyebrow">AIを、毎日の味方に。</p>
			<h1 id="home-title">0から始める<br />優しい<span>AI生活</span></h1>
			<p class="intro-description">はじめてのClaudeから、自分だけのものづくりまで。<br class="desktop-break" />試して、わかったことを、やさしく届けます。</p>
			<div class="intro-actions">
				<a class="primary-link" href="/blog/claude-toha-nanika/">Claudeを知る <span aria-hidden="true">↗</span></a>
				<a class="secondary-link" href="#articles">新しい記事を読む <span aria-hidden="true">↓</span></a>
			</div>
		</div>
		<div class="intro-art" aria-hidden="true">
			<div class="art-orbit"></div><div class="art-disc"></div>
			<div class="art-note"><span>小さな「できた」を、ひとつずつ。</span><strong>HELLO, AI.</strong><span>知る。試す。つくる。</span></div>
		</div>
	</section>
	<nav class="start-links" aria-label="目的から記事を探す">
		<a href="/blog/claude-toha-nanika/"><span>01</span> AIを知りたい <span aria-hidden="true">↗</span></a>
		<a href="/blog/claude-code-tsukaikata/"><span>02</span> 使ってみたい <span aria-hidden="true">↗</span></a>
		<a href="/blog/kangal-kaihatsu-jirei/"><span>03</span> つくってみたい <span aria-hidden="true">↗</span></a>
	</nav>

	{
		featured && (
			<a class="card featured" href={`/blog/${featured.id}/`}>
				<div class="thumb">
					{featured.data.heroImage ? (
						<Image src={featured.data.heroImage} width={800} height={450} alt="" />
					) : (
						<img src={thumbUrl(featured.id)} width="800" height="450" alt="" />
					)}
				</div>
				<div class="body">
					<div class="meta">
						<span class="badge">{categoryOf(featured.id)}</span>
						<FormattedDate date={featured.data.pubDate} />
					</div>
					<h2 class="title">{featured.data.title}</h2>
					<p class="excerpt">{featured.data.description}</p>
					<span class="more">続きを読む →</span>
				</div>
			</a>
		)
	}

	<div class="section-heading" id="articles"><h2>新しい発見</h2><a href="/blog/">記事一覧へ ↗</a></div>
	<ul class="grid">
		{
			rest.map((post) => (
				<li>
					<a class="card" href={`/blog/${post.id}/`}>
						<div class="thumb">
							{post.data.heroImage ? (
								<Image src={post.data.heroImage} width={480} height={270} alt="" />
							) : (
								<img src={thumbUrl(post.id)} width="480" height="270" alt="" loading="lazy" />
							)}
						</div>
						<div class="body">
							<div class="meta">
								<span class="badge">{categoryOf(post.id)}</span>
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h3 class="title">{post.data.title}</h3>
							<p class="excerpt">{post.data.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>

	{
		hasMore && (
			<div class="more-wrap">
				<a class="more-link" href="/blog/">記事一覧をすべて見る →</a>
			</div>
		)
	}
</Base>

<style>
	.intro { display:grid; grid-template-columns:1.35fr 1fr; gap:2rem; align-items:center; padding:3rem 0 4rem; }
	.eyebrow { font-size:.85rem; font-weight:700; letter-spacing:.12em; margin:0 0 1.4rem; color:#555c50; }
	.intro h1 { font-size:clamp(2.5rem,5vw,4.5rem); line-height:1.23; letter-spacing:-.045em; margin:0 0 1.6rem; }
	.intro h1 span { color:#416c36; }
	.intro-description { font-size:1rem; line-height:1.9; color:#5c6058; margin:0; }
	.intro-actions { display:flex; flex-wrap:wrap; align-items:center; gap:1.4rem; margin-top:2rem; }
	.primary-link { display:flex; gap:2rem; align-items:center; padding:.85rem 1.3rem; background:#233b26; color:#fff; border-radius:4px; font-size:.9rem; font-weight:700; text-decoration:none; }
	.primary-link:hover { background:#365a3b; color:#fff; }
	.secondary-link { color:#30382e; font-size:.85rem; text-underline-offset:5px; }
	.intro-art { aspect-ratio:1; position:relative; overflow:hidden; background:#e7ecdc; border-radius:50% 50% 4px 4px; isolation:isolate; }
	.art-orbit { position:absolute; width:80%; aspect-ratio:1; border:1px solid #98a889; border-radius:50%; top:9%; left:10%; }
	.art-orbit::after { content:''; position:absolute; inset:14%; border:1px solid #b4bea5; border-radius:50%; }
	.art-disc { position:absolute; width:52%; aspect-ratio:1; left:24%; top:23%; border-radius:50%; background:repeating-conic-gradient(from 0deg,#77935a 0deg 5deg,#c8d8b3 5deg 10deg); box-shadow:0 16px 24px #3b542523; }
	.art-note { position:absolute; left:7%; right:7%; bottom:8%; background:#fcfcf1ed; padding:1rem 1.2rem; border:1px solid #fff; transform:rotate(-4deg); display:grid; gap:.25rem; }
	.art-note strong { font-size:clamp(1.7rem,3vw,3rem); line-height:1.1; color:#2b4027; letter-spacing:-.04em; }
	.art-note span { font-size:.65rem; color:#52614b; }
	.start-links { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid #ccd1c7; border-bottom:1px solid #ccd1c7; margin-bottom:3rem; }
	.start-links a { display:flex; justify-content:space-between; align-items:center; gap:.75rem; padding:1.4rem 1rem; color:#30382e; font-size:.9rem; text-decoration:none; }
	.start-links a + a { border-left:1px solid #ccd1c7; }
	.start-links a span:first-child { color:#727d68; font-size:.7rem; }
	.start-links a:hover { background:#e7ecdc; }
	.card { display:block; color:inherit; text-decoration:none; }
	.card .thumb { overflow:hidden; background:#e7ecdc; border-radius:5px; aspect-ratio:16/9; }
	.card .thumb :global(img) { display:block; width:100%; height:100%; object-fit:cover; border-radius:0; margin:0; transition:transform .3s ease; }
	.card:hover .thumb :global(img) { transform:scale(1.025); }
	.card:hover .title { color:#416c36; }
	.card .body { padding:1.1rem 0; }
	.meta { display:flex; flex-wrap:wrap; align-items:center; gap:.75rem; margin-bottom:.7rem; font-size:.75rem; color:#626b5b; }
	.badge { font-weight:700; color:#416c36; }
	.card .title { font-size:1.15rem; line-height:1.6; margin:0 0 .7rem; }
	.card .excerpt { color:#5c6058; font-size:.9rem; line-height:1.8; margin:0; }
	.featured { display:grid; grid-template-columns:1.15fr 1fr; gap:2rem; align-items:center; padding-bottom:2.5rem; border-bottom:1px solid #ccd1c7; margin-bottom:3rem; }
	.featured .title { font-size:clamp(1.35rem,2.2vw,1.85rem); }
	.featured .more { display:inline-block; margin-top:1.2rem; font-size:.9rem; font-weight:700; color:#416c36; }
	.section-heading { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:1.75rem; scroll-margin-top:6rem; }
	.section-heading h2 { font-size:1.5rem; margin:0; }
	.section-heading a { color:#416c36; font-size:.85rem; text-underline-offset:4px; }
	.grid { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:2rem; }
	.more-wrap { margin-top:2.5rem; text-align:center; }
	.more-link { display:inline-block; font-weight:700; text-decoration:none; color:#233b26; border:1px solid #9aa78e; padding:.8rem 1.5rem; font-size:.9rem; }
	a:focus-visible { outline:3px solid #416c36; outline-offset:5px; }
	@media(max-width:900px) { .grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .intro { gap:1.5rem; } }
	@media(max-width:600px) { .intro { grid-template-columns:1fr; padding:1rem 0 2rem; } .intro-art { aspect-ratio:1.65; border-radius:5px; } .art-disc { width:40%; left:45%; top:10%; } .art-orbit { width:65%; left:33%; top:-5%; } .art-note { right:25%; bottom:12%; } .intro h1 { font-size:2.65rem; } .desktop-break { display:none; } .start-links { grid-template-columns:1fr; } .start-links a { padding:1rem .5rem; } .start-links a + a { border-left:0; border-top:1px solid #ccd1c7; } .featured { grid-template-columns:1fr; gap:.5rem; } .grid { grid-template-columns:1fr; gap:1.5rem; } }
	@media(prefers-reduced-motion:reduce) { .card .thumb :global(img) { transition:none; } .card:hover .thumb :global(img) { transform:none; } }
</style>
