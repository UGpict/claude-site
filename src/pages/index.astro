---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE, categoryOf, thumbUrl } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>{SITE_TITLE}</h1>
		<p>{SITE_DESCRIPTION}</p>
	</section>

	{
		featured && (
			<a class="card featured" href={`/blog/${featured.id}/`}>
				<div class="thumb">
					{featured.data.heroImage ? (
						<Image src={featured.data.heroImage} width={800} height={450} alt="" />
					) : (
						<img src={thumbUrl(featured.id)} width="800" height="450" alt="" />
					)}
				</div>
				<div class="body">
					<div class="meta">
						<span class="badge">{categoryOf(featured.id)}</span>
						<FormattedDate date={featured.data.pubDate} />
					</div>
					<h2 class="title">{featured.data.title}</h2>
					<p class="excerpt">{featured.data.description}</p>
					<span class="more">続きを読む →</span>
				</div>
			</a>
		)
	}

	<h2 class="section-heading">記事一覧</h2>
	<ul class="grid">
		{
			rest.map((post) => (
				<li>
					<a class="card" href={`/blog/${post.id}/`}>
						<div class="thumb">
							{post.data.heroImage ? (
								<Image src={post.data.heroImage} width={480} height={270} alt="" />
							) : (
								<img src={thumbUrl(post.id)} width="480" height="270" alt="" loading="lazy" />
							)}
						</div>
						<div class="body">
							<div class="meta">
								<span class="badge">{categoryOf(post.id)}</span>
								<FormattedDate date={post.data.pubDate} />
							</div>
							<h3 class="title">{post.data.title}</h3>
							<p class="excerpt">{post.data.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.intro {
		margin-bottom: 2.5rem;
	}
	.intro h1 {
		font-size: 2.2rem;
		margin-bottom: 0.4rem;
	}
	.intro p {
		color: rgb(var(--gray));
		font-size: 1.05rem;
		margin: 0;
		max-width: 46rem;
	}

	.card {
		display: block;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			border-color 0.15s ease;
	}
	.card:hover {
		transform: translateY(-4px);
		box-shadow: var(--box-shadow);
		border-color: transparent;
	}
	.card .thumb {
		overflow: hidden;
		background: rgb(var(--gray-light));
	}
	.card .thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		margin: 0;
	}
	.card .body {
		padding: 1.1rem 1.25rem 1.35rem;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.55rem;
		font-size: 0.82rem;
		color: rgb(var(--gray));
	}
	.badge {
		font-weight: 700;
		color: var(--accent-dark);
		background: rgba(35, 55, 255, 0.1);
		padding: 2px 10px;
		border-radius: 999px;
	}
	.card .title {
		color: rgb(var(--black));
		line-height: 1.35;
		margin: 0 0 0.5rem;
	}
	.card .excerpt {
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		line-height: 1.6;
		margin: 0;
	}

	.featured {
		margin-bottom: 3rem;
	}
	.featured .thumb {
		aspect-ratio: 16 / 9;
	}
	.featured .title {
		font-size: 1.7rem;
	}
	.featured .more {
		display: inline-block;
		margin-top: 0.9rem;
		font-weight: 700;
		color: var(--accent);
	}
	@media (min-width: 900px) {
		.featured {
			display: grid;
			grid-template-columns: 1.2fr 1fr;
		}
		.featured .thumb {
			height: 100%;
			aspect-ratio: auto;
		}
		.featured .body {
			padding: 1.75rem 2rem;
			align-self: center;
		}
	}

	.section-heading {
		font-size: 1.3rem;
		padding-bottom: 0.6rem;
		margin-bottom: 1.5rem;
		border-bottom: 2px solid rgb(var(--gray-light));
	}
	.grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1.5rem;
	}
	.grid .thumb {
		aspect-ratio: 16 / 9;
	}
	.grid .title {
		font-size: 1.1rem;
	}
</style>
