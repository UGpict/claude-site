---
import Base from '../../../layouts/Base.astro';
import ChaosPendulum from '../../../components/games/ChaosPendulum.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';

const title = 'CHAOS BEAT｜暴れる二重振り子をビートで叩くブラウザゲーム';
const description =
	'カオスに暴れる二重振り子を、拍に合わせて黄色い丸で叩け。60秒で1曲を遊び切り、コンボを繋いでPERFECTを狙うリズム×カオスのブラウザゲーム。スマホでもPCでも、インストール不要ですぐ遊べます。';

// OGP 画像は scripts/genThumbnails.mjs が /thumb/_game-chaos-pendulum.webp を生成する。
---

<Base
	title={title}
	description={description}
	shareTitle="CHAOS BEAT"
	ogImage="/thumb/_game-chaos-pendulum.webp"
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&display=swap"
			rel="stylesheet"
		/>
	</Fragment>

	<article class="game-page">
		<!-- ① HERO：何をするゲームかを1〜2行で。説明より先に PLAY -->
		<header class="hero">
			<h1>CHAOS BEAT</h1>
			<p class="hero-copy">音を聞いて、<br />振り子が丸に重なる瞬間を叩け。</p>
			<div class="hero-cta">
				<button type="button" class="play-btn" data-play-cta>▶ PLAY</button>
				<p class="hero-meta">タップ / クリック / Space<br />1プレイ 約60秒</p>
			</div>
		</header>

		<!-- ② GAME（TAP TO START で開始）→ ③ 遊び方 → ④ FEVER / コンボ → ⑤ ランキング（コンポーネント内） -->
		<section class="play-area" aria-label="ゲーム">
			<ChaosPendulum>
				<Fragment slot="guide">
					<!-- ③ 遊び方：3ステップ（文章ではなく図＋一言） -->
					<section class="howto" aria-labelledby="howto-title">
						<h2 id="howto-title">遊び方は3ステップ</h2>
						<ol class="steps">
							<li class="step">
								<div class="fig fig-sound" aria-hidden="true">
									<span>♪</span><span>♪</span><span>♪</span><b>ドン！</b>
								</div>
								<p class="step-no">STEP 1</p>
								<h3>音を聞く</h3>
								<p>タン・タン・タン…… 次に押すタイミングを音が教えてくれます。</p>
							</li>
							<li class="step">
								<div class="fig fig-ring" aria-hidden="true">
									<i class="ring"></i><i class="dot-target"></i>
								</div>
								<p class="step-no">STEP 2</p>
								<h3>輪を見る</h3>
								<p>外側の輪が黄色い丸へ縮んでいきます。</p>
							</li>
							<li class="step">
								<div class="fig fig-hit" aria-hidden="true">
									<i class="dot-target"></i><i class="bob"></i><b>PERFECT!</b>
								</div>
								<p class="step-no">STEP 3</p>
								<h3>ドン！で叩く</h3>
								<p>振り子（ピンクの玉）が丸に重なる瞬間にタップ。</p>
							</li>
						</ol>

						<!-- 判定（色だけに頼らず文字で） -->
						<dl class="judge" aria-label="判定">
							<div><dt class="j-perfect">PERFECT</dt><dd>真ん中！</dd></div>
							<div><dt class="j-great">GREAT</dt><dd>かなり近い</dd></div>
							<div><dt class="j-good">GOOD</dt><dd>コンボ継続</dd></div>
							<div><dt class="j-near">NEAR MISS</dt><dd>あと少し！</dd></div>
							<div><dt class="j-miss">MISS</dt><dd>コンボ切れ</dd></div>
						</dl>
					</section>

					<!-- ④ 目標：CHAOS FEVER とコンボ -->
					<section class="goals" aria-label="目標">
						<div class="goal goal-fever">
							<p class="goal-kicker">PERFECT ×3</p>
							<h2>🔥 CHAOS FEVER</h2>
							<p class="goal-lead">PERFECTを3連続すると突入！</p>
							<ul>
								<li>スコア <b>×2</b></li>
								<li>音楽が一気に豪華に</li>
								<li>画面が虹色に変化</li>
							</ul>
						</div>
						<div class="goal goal-chaos">
							<p class="goal-kicker">RARE</p>
							<h2>⚡ CHAOS PERFECT</h2>
							<p class="goal-lead">振り子がいちばん荒れる瞬間、<br />的が電撃で光ったら PERFECT で叩き抜け。</p>
							<p class="goal-note">1曲に数回だけのチャンス。結果画面に「取った数 / チャンス数」が残ります。</p>
						</div>
						<div class="goal goal-combo">
							<p class="goal-kicker">COMBO</p>
							<h2>♪ 曲が育つ</h2>
							<p class="goal-lead">コンボをつなぐと、<br />曲がどんどん完成していく。</p>
							<p class="goal-note">MISS すると音が減ってしまう…</p>
						</div>
					</section>
				</Fragment>
			</ChaosPendulum>
		</section>

		<!-- 6. SNS シェア -->
		<section class="share">
			<h2>スコアをシェア</h2>
			<p class="share-note" data-share-note>ゲームを1回遊ぶと、スコア付きでシェアできます。</p>
			<button type="button" class="share-btn" data-share-btn disabled>結果をシェア</button>
		</section>

		<!-- 誤タップ防止のため、ゲーム操作領域から十分に離してから広告を置く -->
		<div class="ad-gap" aria-hidden="true"></div>

		<!-- 広告（楽天アフィリエイト。もしも経由・「スポンサーリンク」表記つき） -->
		<AffiliateBanner />

		<!-- ⑥ 詳しい情報（遊ぶ前に読まなくていいもの）は下へ -->
		<section class="more" aria-label="詳しい情報">
			<h2>もっと詳しく</h2>
			<details class="acc" data-acc="song">
				<summary>60秒の曲の流れ・難易度・ランキング</summary>
				<div class="acc-body">
					<p>
						1ゲームは<strong>60秒で1曲</strong>。<b>INTRO</b>（やさしい譜面）→ <b>GROOVE</b> → <b>BUILD</b>（裏拍が増える）→
						<b>CLIMAX</b>（いちばん難しく、曲も厚く）→ <b>FINAL</b>（最後の5カウント）と展開します。
					</p>
					<ul>
						<li>コンボ倍率：3 → ×1.2 / 5 → ×1.5 / 10 → ×2.0。コンボ 3・5・10 でベース・ハイハット・メロディが加わります。</li>
						<li>難易度は<b>易しい／普通／難しい／鬼</b>の4段階。振り子の速さはそのまま、<b>的の大きさ</b>（と初期の暴れ方）が変わります。</li>
						<li><b>ランキングは難易度ごと</b>にスコアと最大コンボで競います。登録は任意です。</li>
					</ul>
				</div>
			</details>
			<details class="acc" data-acc="tech">
				<summary>このゲームのしくみ</summary>
				<div class="acc-body">
					<ul>
						<li><b>二重振り子</b>：振り子の先にもう1本振り子をつないだもの。わずかな差で動きがまったく変わる「カオス」の代表例です。RK4（ルンゲ＝クッタ法）で計算しています。</li>
						<li><b>未来軌道予測</b>：振り子の少し先の動きを計算し、「ドン！」の瞬間に先端が通る場所へ的を置いています。だから音どおりに押せば必ず当たります。</li>
						<li><b>音</b>：外部の音源は使わず、Web Audio API でその場で合成。BGM・予告音・的・輪はすべて同じ拍（BPM130）の上で動いています。</li>
					</ul>
				</div>
			</details>
		</section>

		<!-- 8. 「このゲームをどう作ったか」記事への導線 -->
		<section class="making-of">
			<h2>このゲームの作り方</h2>
			<p>
				このゲームを Claude と一緒に作った過程は、制作記録にまとめました。
				物理を触らずにブログへ載せ替えた工夫や、正直まだ難易度が崩れている話まで
				<a href="/blog/chaos-pendulum-tsukutta/">カオスな二重振り子のミニゲームをAIと遊びで作った話</a>でどうぞ。
			</p>
		</section>

		<!-- 9. 関連記事領域 -->
		<section class="related">
			<h2>関連記事</h2>
			<ul>
				<li><a href="/blog/shoshinsha-hitokara-tsukutta/">HTML未経験から約1.5ヶ月でBtoBサイトを自作した話</a></li>
				<li><a href="/blog/blog-jisaku-skill/">このブログを回している自作スキルの話</a></li>
				<li><a href="/blog/ai-inyou-shinki-site/">新規サイトのGEO現在地レポート</a></li>
			</ul>
		</section>
	</article>
</Base>

<script>
	import { trackGameEvent } from '../../../scripts/games/analytics';

	// ▶ PLAY：ゲームを画面に入れて TAP TO START にフォーカスするだけ（ゲーム開始はしない）
	document.querySelector<HTMLButtonElement>('[data-play-cta]')?.addEventListener('click', () => {
		trackGameEvent('play_cta_click', {});
		document.dispatchEvent(new CustomEvent('chaospendulum:focus'));
	});

	// 詳しい情報のアコーディオンを開いたら計測（どの説明が読まれているか）
	document.querySelectorAll<HTMLDetailsElement>('details[data-acc]').forEach((d) => {
		d.addEventListener('toggle', () => {
			if (d.open) trackGameEvent('howto_open', { section: d.dataset.acc });
		});
	});

	const btn = document.querySelector<HTMLButtonElement>('[data-share-btn]');
	const note = document.querySelector<HTMLElement>('[data-share-note]');

	let lastScore: number | null = null;
	let lastCombo = 0;

	function buildShareText(score: number, maxCombo: number): string {
		return (
			`CHAOS BEAT で ${score}点（最大${maxCombo}コンボ）！\n\n` +
			`暴れる二重振り子を\nビートに合わせて叩くゲーム。\n\n` +
			`あなたは何点取れる？\n\n#CHAOSBEAT`
		);
	}

	document.addEventListener('chaospendulum:complete', (e) => {
		const detail = (e as CustomEvent<{ score: number; maxCombo: number }>).detail;
		if (!detail) return;
		lastScore = detail.score;
		lastCombo = detail.maxCombo;
		if (btn) btn.disabled = false;
		if (note)
			note.textContent = `今回は ${detail.score}点・最大${detail.maxCombo}コンボ。シェアできます！`;
	});

	btn?.addEventListener('click', async () => {
		if (lastScore == null) return;
		const url = window.location.href;
		const text = buildShareText(lastScore, lastCombo);

		trackGameEvent('score_share', { score: lastScore });

		// Web Share API が使える端末では将来的にそちらを優先できるよう分岐しておく。
		if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') {
			try {
				await navigator.share({ text, url });
				return;
			} catch {
				// キャンセル等は握りつぶし、X へのフォールバックへ
			}
		}
		const intent =
			'https://twitter.com/intent/tweet?text=' +
			encodeURIComponent(text) +
			'&url=' +
			encodeURIComponent(url);
		window.open(intent, '_blank', 'noopener,noreferrer');
	});
</script>

<style>
	.game-page {
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
	}
	/* ① HERO */
	.hero {
		margin: 0 0 0.9em;
	}
	.game-page h1 {
		font-size: 2.1rem;
		line-height: 1.1;
		letter-spacing: 0.04em;
		margin: 0;
	}
	.hero-copy {
		margin: 0.35em 0 0;
		font-size: 1.1rem;
		font-weight: 700;
		line-height: 1.5;
		color: #222222;
	}
	.hero-cta {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 0.75em;
	}
	.play-btn {
		font: inherit;
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: 0.06em;
		min-height: 48px;
		padding: 10px 34px;
		border: none;
		border-radius: 999px;
		background: #f2d06b;
		color: #1f2a25;
		cursor: pointer;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
		transition: transform 0.12s ease;
	}
	.play-btn:hover {
		transform: translateY(-1px);
	}
	.play-btn:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}
	.hero-meta {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.45;
		color: #555555;
	}
	.game-page h2 {
		font-size: 1.35rem;
		margin: 1.6em 0 0.6em;
		padding-bottom: 0.25em;
		border-bottom: 2px solid rgb(var(--gray-light));
	}
	.play-area {
		margin: 0 0 0.5em;
	}

	/* ③ 遊び方：3ステップ */
	.howto h2 {
		margin-top: 1.4em;
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}
	.step {
		background: #ffffff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		padding: 12px 14px 14px;
	}
	.step h3 {
		margin: 0 0 0.3em;
		font-size: 1.1rem;
	}
	.step p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.65;
		color: #444444;
	}
	.step .step-no {
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: rgb(var(--gray));
		margin: 0.5em 0 0.1em;
	}
	/* 図（ゲーム盤と同じ黒板色で、実際の見た目に寄せる） */
	.fig {
		position: relative;
		height: 76px;
		border-radius: 10px;
		background: #2f3e37;
		color: #ece8dc;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		overflow: hidden;
	}
	.fig-sound span {
		font-size: 1.1rem;
		opacity: 0.7;
	}
	.fig-sound b {
		font-size: 1.3rem;
		color: #f2d06b;
	}
	.fig .dot-target {
		width: 34px;
		height: 34px;
		border: 3px dashed #f2d06b;
		border-radius: 50%;
	}
	.fig-ring .ring {
		position: absolute;
		width: 62px;
		height: 62px;
		border: 2px solid #8cc7e0;
		border-radius: 50%;
		animation: fig-shrink 1.4s ease-in infinite;
	}
	@keyframes fig-shrink {
		from {
			transform: scale(1.15);
			opacity: 0.5;
		}
		to {
			transform: scale(0.62);
			opacity: 1;
		}
	}
	.fig-hit .dot-target {
		position: absolute;
		left: calc(50% - 50px);
	}
	.fig-hit .bob {
		position: absolute;
		left: calc(50% - 41px);
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: #ee93a8;
	}
	.fig-hit b {
		margin-left: 46px;
		font-size: 1.05rem;
		color: #f2d06b;
		letter-spacing: 0.04em;
	}
	@media (prefers-reduced-motion: reduce) {
		.fig-ring .ring {
			animation: none;
			transform: scale(0.85);
		}
	}

	/* 判定（色は補助。文字で意味が分かる） */
	.judge {
		margin: 14px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		font-size: 0.88rem;
	}
	.judge div {
		display: flex;
		align-items: baseline;
		gap: 6px;
	}
	.judge dt {
		font-weight: 800;
		letter-spacing: 0.03em;
	}
	.judge dd {
		margin: 0;
		color: #444444;
	}
	.j-perfect {
		color: #a4790a;
	}
	.j-great {
		color: #b0476a;
	}
	.j-good {
		color: #2f6f8a;
	}
	.j-near,
	.j-miss {
		color: #666666;
	}

	/* ④ 目標：FEVER / コンボ */
	.goals {
		margin-top: 1.4em;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}
	.goal {
		border-radius: 14px;
		padding: 14px 16px 16px;
	}
	.goal h2 {
		margin: 0.1em 0 0.25em;
		padding: 0;
		border: none;
		font-size: 1.35rem;
	}
	.goal-kicker {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		opacity: 0.8;
	}
	.goal-lead {
		margin: 0 0 0.4em;
		font-weight: 700;
		line-height: 1.55;
	}
	.goal ul {
		margin: 0;
		padding-left: 1.2em;
		line-height: 1.75;
	}
	.goal-note {
		margin: 0;
		font-size: 0.85rem;
		opacity: 0.8;
	}
	/* FEVER：黒板色のカードに虹の縁と虹色の見出し（白文字×淡色グラデの低コントラストを避ける） */
	.goal-fever {
		grid-column: 1 / -1;
		color: #ece8dc;
		border: 3px solid transparent;
		background:
			linear-gradient(#1f2a25, #1f2a25) padding-box,
			linear-gradient(135deg, #f2d06b, #ee93a8, #b79cf2, #7fe3f0) border-box;
	}
	.goal-fever .goal-kicker {
		color: #f2d06b;
		opacity: 1;
	}
	.goal-fever h2 {
		color: #ee93a8; /* グラデ非対応時 */
		background: linear-gradient(90deg, #f2d06b, #ee93a8, #b79cf2, #7fe3f0);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.goal-fever b {
		color: #f2d06b;
	}
	.goal-chaos {
		background: #14202a;
		color: #e8fbff;
		border: 2px solid #7fe3f0;
	}
	.goal-chaos .goal-kicker {
		color: #7fe3f0;
		opacity: 1;
	}
	.goal-chaos h2 {
		color: #ffffff;
	}
	.goal-combo {
		background: #2f3e37;
		color: #ece8dc;
	}
	.goal-combo .goal-kicker {
		color: #8cc7e0;
		opacity: 1;
	}
	.goal-combo h2 {
		color: #f2d06b;
	}

	/* ⑥ 詳しい情報（アコーディオン） */
	.more {
		display: flex;
		flex-direction: column;
		gap: 0.6em;
	}
	.more h2 {
		margin-bottom: 0.2em;
	}
	.acc {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: #ffffff;
		overflow: hidden;
	}
	.acc summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 48px;
		padding: 10px 16px;
		font-weight: 700;
		font-size: 1rem;
		color: #222222;
		-webkit-tap-highlight-color: transparent;
	}
	.acc summary::-webkit-details-marker {
		display: none;
	}
	.acc summary::after {
		content: '';
		flex: none;
		width: 9px;
		height: 9px;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg) translateY(-2px);
		transition: transform 0.2s ease;
		opacity: 0.6;
	}
	.acc[open] summary::after {
		transform: rotate(-135deg) translateY(-2px);
	}
	.acc summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
		border-radius: 12px;
	}
	.acc-body {
		padding: 0 16px 14px;
		line-height: 1.85;
		color: #333333;
	}
	.acc-body p {
		margin: 0 0 0.6em;
	}
	.acc-body ul {
		margin: 0 0 0.6em;
		padding-left: 1.3em;
	}
	.acc-body li {
		margin-bottom: 0.3em;
	}
	@media (prefers-reduced-motion: reduce) {
		.acc summary::after,
		.play-btn {
			transition: none;
		}
	}

	/* シェア */
	.share {
		margin-top: 1.4em;
	}
	.share-note {
