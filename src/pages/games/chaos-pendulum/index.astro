---
import Base from '../../../layouts/Base.astro';
import ChaosPendulum from '../../../components/games/ChaosPendulum.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';

const title = 'CHAOS BEAT｜暴れる二重振り子をビートで叩くブラウザゲーム';
const description =
	'カオスに暴れる二重振り子を、拍に合わせて黄色い丸で叩け。30秒でコンボを繋ぎ、PERFECTを狙うリズム×カオスのブラウザゲーム。スマホでもPCでも、インストール不要ですぐ遊べます。';

// OGP 画像は scripts/genThumbnails.mjs が /thumb/_game-chaos-pendulum.webp を生成する。
---

<Base
	title={title}
	description={description}
	shareTitle="CHAOS BEAT"
	ogImage="/thumb/_game-chaos-pendulum.webp"
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&display=swap"
			rel="stylesheet"
		/>
	</Fragment>

	<article class="game-page">
		<!-- 1. タイトル -->
		<h1>CHAOS BEAT</h1>

		<!-- 2. 短い説明 -->
		<p class="lead">
			カオスに暴れる<strong>二重振り子</strong>を、拍に合わせて<strong>叩く</strong>リズムゲームです。
			先端（ピンクのおもり）が黄色い丸に重なる一瞬をビートで狙い、コンボを繋いでいきます。
			1ゲーム<strong>30秒</strong>。終わったらすぐ「もう一回」で最高記録を更新しましょう。
		</p>

		<!-- 3. 操作方法 -->
		<section class="how-to">
			<h2>遊び方</h2>
			<ul>
				<li><b>画面タップ</b>／<b>スペースキー</b>で「叩く」。先端が黄色い丸に近いほど高判定。</li>
				<li>判定は <b>PERFECT / GREAT / GOOD</b> が加点、<b>NEAR MISS / MISS</b> は0点。GOOD以上で<b>コンボ</b>が伸びます。</li>
				<li>コンボが伸びると<b>倍率アップ</b>（3→×1.2 / 5→×1.5 / 10→×2.0）。MISS でコンボは途切れます。</li>
				<li>的は<b>これから先端が通る軌道上</b>に出ます。近づいてくる先端が丸に重なる<b>一瞬</b>を、脈動と拍の音に乗って叩くのがコツ（逃すと次の的へ）。</li>
				<li><b>PERFECT を3連続</b>で <b>🔥CHAOS FEVER</b>（得点2倍・振り子加速）。MISS で解除。易しい・普通は的の近くで少しスローになる<b>アシスト</b>つき。</li>
				<li>難易度は<b>易しい／普通／難しい／鬼</b>の4段階。カオスはそのまま、<b>的の大きさ</b>（鬼は速度も）が変わります。<b>ランキングは難易度ごと</b>にスコアと最大コンボで競います。</li>
			</ul>
		</section>

		<!-- 4. ゲーム本体 ＋ 5. 結果表示（コンポーネント内のメッセージ／キャンバス演出） -->
		<section class="play-area">
			<ChaosPendulum />
		</section>

		<!-- 6. SNS シェア -->
		<section class="share">
			<h2>スコアをシェア</h2>
			<p class="share-note" data-share-note>ゲームを1回遊ぶと、スコア付きでシェアできます。</p>
			<button type="button" class="share-btn" data-share-btn disabled>結果をシェア</button>
		</section>

		<!-- 誤タップ防止のため、ゲーム操作領域から十分に離してから広告を置く -->
		<div class="ad-gap" aria-hidden="true"></div>

		<!-- 広告（楽天アフィリエイト。もしも経由・「スポンサーリンク」表記つき） -->
		<AffiliateBanner />

		<!-- 8. 「このゲームをどう作ったか」記事への導線 -->
		<section class="making-of">
			<h2>このゲームの作り方</h2>
			<p>
				このゲームを Claude と一緒に作った過程は、制作記録にまとめました。
				物理を触らずにブログへ載せ替えた工夫や、正直まだ難易度が崩れている話まで
				<a href="/blog/chaos-pendulum-tsukutta/">カオスな二重振り子のミニゲームをAIと遊びで作った話</a>でどうぞ。
			</p>
		</section>

		<!-- 9. 関連記事領域 -->
		<section class="related">
			<h2>関連記事</h2>
			<ul>
				<li><a href="/blog/shoshinsha-hitokara-tsukutta/">HTML未経験から約1.5ヶ月でBtoBサイトを自作した話</a></li>
				<li><a href="/blog/blog-jisaku-skill/">このブログを回している自作スキルの話</a></li>
				<li><a href="/blog/ai-inyou-shinki-site/">新規サイトのGEO現在地レポート</a></li>
			</ul>
		</section>
	</article>
</Base>

<script>
	import { trackGameEvent } from '../../../scripts/games/analytics';

	const btn = document.querySelector<HTMLButtonElement>('[data-share-btn]');
	const note = document.querySelector<HTMLElement>('[data-share-note]');

	let lastScore: number | null = null;
	let lastCombo = 0;

	function buildShareText(score: number, maxCombo: number): string {
		return (
			`CHAOS BEAT で ${score}点（最大${maxCombo}コンボ）！\n\n` +
			`暴れる二重振り子を\nビートに合わせて叩くゲーム。\n\n` +
			`あなたは何点取れる？\n\n#CHAOSBEAT`
		);
	}

	document.addEventListener('chaospendulum:complete', (e) => {
		const detail = (e as CustomEvent<{ score: number; maxCombo: number }>).detail;
		if (!detail) return;
		lastScore = detail.score;
		lastCombo = detail.maxCombo;
		if (btn) btn.disabled = false;
		if (note)
			note.textContent = `今回は ${detail.score}点・最大${detail.maxCombo}コンボ。シェアできます！`;
	});

	btn?.addEventListener('click', async () => {
		if (lastScore == null) return;
		const url = window.location.href;
		const text = buildShareText(lastScore, lastCombo);

		trackGameEvent('score_share', { score: lastScore });

		// Web Share API が使える端末では将来的にそちらを優先できるよう分岐しておく。
		if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') {
			try {
				await navigator.share({ text, url });
				return;
			} catch {
				// キャンセル等は握りつぶし、X へのフォールバックへ
			}
		}
		const intent =
			'https://twitter.com/intent/tweet?text=' +
			encodeURIComponent(text) +
			'&url=' +
			encodeURIComponent(url);
		window.open(intent, '_blank', 'noopener,noreferrer');
	});
</script>

<style>
	.game-page {
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
	}
	.game-page h1 {
		font-size: 1.9rem;
		line-height: 1.3;
		margin: 0 0 0.6em;
	}
	.game-page h2 {
		font-size: 1.35rem;
		margin: 1.6em 0 0.6em;
		padding-bottom: 0.25em;
		border-bottom: 2px solid rgb(var(--gray-light));
	}
	.lead {
		font-size: 1.05rem;
		line-height: 1.9;
		color: #333333;
		margin: 0 0 1.6em;
	}
	.how-to ul {
		line-height: 1.9;
		color: #333333;
		padding-left: 1.3em;
	}
	.how-to li {
		margin-bottom: 0.35em;
	}
	.play-area {
		margin: 1.2em 0 0.5em;
	}

	/* シェア */
	.share {
		margin-top: 1.4em;
	}
	.share-note {
		color: #555555;
		margin: 0 0 0.8em;
	}
	.share-btn {
		font: inherit;
		font-weight: 700;
		font-size: 1rem;
		background: var(--accent);
		color: #ffffff;
		border: none;
		border-radius: 999px;
		padding: 12px 30px;
		cursor: pointer;
	}
	.share-btn:disabled {
		background: rgb(var(--gray-light));
		color: #888888;
		cursor: not-allowed;
	}

	/* 広告はゲーム操作領域から十分に離す（タップ誤クリック防止） */
	.ad-gap {
		height: 3rem;
	}

	.making-of p,
	.related li {
		line-height: 1.9;
		color: #333333;
	}
	.related ul {
		padding-left: 1.3em;
	}
	.related a,
	.making-of a {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.game-page h1 {
			font-size: 1.55rem;
		}
	}
</style>
