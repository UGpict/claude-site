---
import Base from '../../../layouts/Base.astro';
import ChaosPendulum from '../../../components/games/ChaosPendulum.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';

const title = 'CHAOS BEAT｜暴れる二重振り子をビートで叩くブラウザゲーム';
const description =
	'カオスに暴れる二重振り子を、拍に合わせて黄色い丸で叩け。60秒で1曲を遊び切り、コンボを繋いでPERFECTを狙うリズム×カオスのブラウザゲーム。スマホでもPCでも、インストール不要ですぐ遊べます。';

// OGP 画像は scripts/genThumbnails.mjs が /thumb/_game-chaos-pendulum.webp を生成する。
---

<Base
	title={title}
	description={description}
	shareTitle="CHAOS BEAT"
	ogImage="/thumb/_game-chaos-pendulum.webp"
>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&display=swap"
			rel="stylesheet"
		/>
	</Fragment>

	<article class="game-page">
		<!-- 1. タイトル＋一行説明（スマホで開いた瞬間にゲームが見えるよう最小限に） -->
		<header class="game-head">
			<h1>CHAOS BEAT</h1>
			<p class="tagline">暴れる二重振り子を、<strong>ビートに合わせて叩く</strong>60秒リズムゲーム</p>
		</header>

		<!-- 2. ゲーム本体（説明より先に置く＝すぐ遊べる） -->
		<section class="play-area" aria-label="ゲーム">
			<ChaosPendulum />
		</section>

		<!-- 3. 遊び方（アコーディオン。初期は閉じる。内容は検索エンジン向けに DOM に残す） -->
		<section class="guide" aria-label="遊び方とルール">
			<details class="acc" data-acc="howto">
				<summary>遊び方（まずはここだけ）</summary>
				<div class="acc-body">
					<ol class="quick">
						<li><b>TAP TO START</b> → 「3・2・1・GO」</li>
						<li>「タン・タン・<b>ドン！</b>」の<b>ドン</b>で画面を<b>タップ</b>（PC はスペースキー）</li>
						<li>縮んでくる<b>輪</b>が黄色い丸に重なる瞬間＝ドン。先端（ピンクの玉）が丸の中心に近いほど高判定</li>
					</ol>
					<p>
						音だけでも GOOD 以上、振り子を目で見て微調整すると PERFECT が狙えます。的は<b>ドンの瞬間に先端が通る軌道上</b>に出ます。
					</p>
				</div>
			</details>

			<details class="acc" data-acc="rules">
				<summary>判定・コンボ・CHAOS FEVER</summary>
				<div class="acc-body">
					<ul>
						<li><b>PERFECT / GREAT / GOOD</b> が加点、<b>NEAR MISS / MISS</b> は0点。GOOD以上で<b>コンボ</b>が伸びます。</li>
						<li>コンボで<b>倍率アップ</b>（3→×1.2 / 5→×1.5 / 10→×2.0）。コンボが伸びるほど曲の音が増えていきます。MISS で途切れます。</li>
						<li><b>PERFECT を3連続</b>で <b>🔥CHAOS FEVER</b>（得点2倍・的が虹色に・曲が最高潮に）。MISS で解除。</li>
					</ul>
				</div>
			</details>

			<details class="acc" data-acc="song">
				<summary>60秒の曲の流れ・難易度・ランキング</summary>
				<div class="acc-body">
					<p>
						カオスに暴れる<strong>二重振り子</strong>を、拍に合わせて<strong>叩く</strong>リズムゲームです。
						1ゲームは<strong>60秒で1曲</strong>。<b>INTRO</b>（やさしい譜面）→ <b>GROOVE</b> → <b>BUILD</b>（裏拍が増える）→
						<b>CLIMAX</b>（いちばん難しく、曲も厚く）→ <b>FINAL</b>（最後の5カウント）と展開します。
					</p>
					<ul>
						<li>難易度は<b>易しい／普通／難しい／鬼</b>の4段階。カオスと振り子の速さはそのまま、<b>的の大きさ</b>（と初期の暴れ方）が変わります。</li>
						<li><b>ランキングは難易度ごと</b>にスコアと最大コンボで競います。終わったらすぐ「もう一回」で記録更新を狙いましょう。</li>
					</ul>
				</div>
			</details>
		</section>

		<!-- 6. SNS シェア -->
		<section class="share">
			<h2>スコアをシェア</h2>
			<p class="share-note" data-share-note>ゲームを1回遊ぶと、スコア付きでシェアできます。</p>
			<button type="button" class="share-btn" data-share-btn disabled>結果をシェア</button>
		</section>

		<!-- 誤タップ防止のため、ゲーム操作領域から十分に離してから広告を置く -->
		<div class="ad-gap" aria-hidden="true"></div>

		<!-- 広告（楽天アフィリエイト。もしも経由・「スポンサーリンク」表記つき） -->
		<AffiliateBanner />

		<!-- 8. 「このゲームをどう作ったか」記事への導線 -->
		<section class="making-of">
			<h2>このゲームの作り方</h2>
			<p>
				このゲームを Claude と一緒に作った過程は、制作記録にまとめました。
				物理を触らずにブログへ載せ替えた工夫や、正直まだ難易度が崩れている話まで
				<a href="/blog/chaos-pendulum-tsukutta/">カオスな二重振り子のミニゲームをAIと遊びで作った話</a>でどうぞ。
			</p>
		</section>

		<!-- 9. 関連記事領域 -->
		<section class="related">
			<h2>関連記事</h2>
			<ul>
				<li><a href="/blog/shoshinsha-hitokara-tsukutta/">HTML未経験から約1.5ヶ月でBtoBサイトを自作した話</a></li>
				<li><a href="/blog/blog-jisaku-skill/">このブログを回している自作スキルの話</a></li>
				<li><a href="/blog/ai-inyou-shinki-site/">新規サイトのGEO現在地レポート</a></li>
			</ul>
		</section>
	</article>
</Base>

<script>
	import { trackGameEvent } from '../../../scripts/games/analytics';

	// 遊び方アコーディオンを開いたら計測（どの説明が読まれているか）
	document.querySelectorAll<HTMLDetailsElement>('details[data-acc]').forEach((d) => {
		d.addEventListener('toggle', () => {
			if (d.open) trackGameEvent('howto_open', { section: d.dataset.acc });
		});
	});

	const btn = document.querySelector<HTMLButtonElement>('[data-share-btn]');
	const note = document.querySelector<HTMLElement>('[data-share-note]');

	let lastScore: number | null = null;
	let lastCombo = 0;

	function buildShareText(score: number, maxCombo: number): string {
		return (
			`CHAOS BEAT で ${score}点（最大${maxCombo}コンボ）！\n\n` +
			`暴れる二重振り子を\nビートに合わせて叩くゲーム。\n\n` +
			`あなたは何点取れる？\n\n#CHAOSBEAT`
		);
	}

	document.addEventListener('chaospendulum:complete', (e) => {
		const detail = (e as CustomEvent<{ score: number; maxCombo: number }>).detail;
		if (!detail) return;
		lastScore = detail.score;
		lastCombo = detail.maxCombo;
		if (btn) btn.disabled = false;
		if (note)
			note.textContent = `今回は ${detail.score}点・最大${detail.maxCombo}コンボ。シェアできます！`;
	});

	btn?.addEventListener('click', async () => {
		if (lastScore == null) return;
		const url = window.location.href;
		const text = buildShareText(lastScore, lastCombo);

		trackGameEvent('score_share', { score: lastScore });

		// Web Share API が使える端末では将来的にそちらを優先できるよう分岐しておく。
		if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') {
			try {
				await navigator.share({ text, url });
				return;
			} catch {
				// キャンセル等は握りつぶし、X へのフォールバックへ
			}
		}
		const intent =
			'https://twitter.com/intent/tweet?text=' +
			encodeURIComponent(text) +
			'&url=' +
			encodeURIComponent(url);
		window.open(intent, '_blank', 'noopener,noreferrer');
	});
</script>

<style>
	.game-page {
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
	}
	.game-head {
		margin: 0 0 0.7em;
	}
	.game-page h1 {
		font-size: 1.7rem;
		line-height: 1.2;
		margin: 0;
	}
	.tagline {
		margin: 0.3em 0 0;
		font-size: 0.98rem;
		line-height: 1.5;
		color: #444444;
	}
	.game-page h2 {
		font-size: 1.35rem;
		margin: 1.6em 0 0.6em;
		padding-bottom: 0.25em;
		border-bottom: 2px solid rgb(var(--gray-light));
	}
	.play-area {
		margin: 0 0 0.5em;
	}

	/* 遊び方アコーディオン */
	.guide {
		margin-top: 1.2em;
		display: flex;
		flex-direction: column;
		gap: 0.6em;
	}
	.acc {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		background: #ffffff;
		overflow: hidden;
	}
	.acc summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 48px; /* 指で押しやすい高さ */
		padding: 10px 16px;
		font-weight: 700;
		font-size: 1rem;
		color: #222222;
		-webkit-tap-highlight-color: transparent;
	}
	.acc summary::-webkit-details-marker {
		display: none;
	}
	.acc summary::after {
		content: '';
		flex: none;
		width: 9px;
		height: 9px;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg) translateY(-2px);
		transition: transform 0.2s ease;
		opacity: 0.6;
	}
	.acc[open] summary::after {
		transform: rotate(-135deg) translateY(-2px);
	}
	.acc summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
		border-radius: 12px;
	}
	.acc-body {
		padding: 0 16px 14px;
		line-height: 1.85;
		color: #333333;
	}
	.acc-body p {
		margin: 0 0 0.6em;
	}
	.acc-body ul,
	.acc-body ol {
		margin: 0 0 0.6em;
		padding-left: 1.3em;
	}
	.acc-body li {
		margin-bottom: 0.3em;
	}
	@media (prefers-reduced-motion: reduce) {
		.acc summary::after {
			transition: none;
		}
	}

	/* シェア */
	.share {
		margin-top: 1.4em;
	}
	.share-note {
		color: #555555;
		margin: 0 0 0.8em;
	}
	.share-btn {
		font: inherit;
		font-weight: 700;
		font-size: 1rem;
		background: var(--accent);
		color: #ffffff;
		border: none;
		border-radius: 999px;
		padding: 12px 30px;
		cursor: pointer;
	}
	.share-btn:disabled {
		background: rgb(var(--gray-light));
		color: #888888;
		cursor: not-allowed;
	}

	/* 広告はゲーム操作領域から十分に離す（タップ誤クリック防止） */
	.ad-gap {
		height: 3rem;
	}

	.making-of p,
	.related li {
		line-height: 1.9;
		color: #333333;
	}
	.related ul {
		padding-left: 1.3em;
	}
	.related a,
	.making-of a {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.game-page h1 {
			font-size: 1.4rem;
		}
		.tagline {
			font-size: 0.9rem;
		}
	}
</style>
