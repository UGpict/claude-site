---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">
				<Image src={logo} alt="" class="brand-logo" width={64} height={64} />
				<span>{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/blog/">記事一覧</HeaderLink>
			<HeaderLink href="/about/">このブログについて</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: sticky;
		top: 0;
		z-index: 50;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	h2 a {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
	}
	.brand-logo {
		height: 30px;
		width: 30px;
		border-radius: 7px;
		flex: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
	@media (max-width: 700px) {
		header {
			padding: 0 0.9em;
		}
		nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
		}
		h2 {
			padding: 0.5em 0 0.15em;
			font-size: 1.05em;
			max-width: 100%;
		}
		h2 a {
			max-width: 100%;
		}
		h2 a span {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			min-width: 0;
		}
		.internal-links {
			display: flex;
			flex-wrap: wrap;
			gap: 0 0.4rem;
		}
		nav a {
			padding: 0.45em 0.5em 0.6em 0;
			font-size: 0.9rem;
			border-bottom-width: 3px;
		}
	}
</style>
