		border-color: var(--pink);
	}

	.cp-timebar {
		height: 5px;
		margin: 10px 20px 0;
		background: var(--chalk-dim);
		border-radius: 3px;
		overflow: hidden;
	}
	.cp-timebar i {
		display: block;
		height: 100%;
		width: 100%;
		background: var(--yellow);
		transition: width 0.1s linear;
	}
	/* プレイ中はサイト共通の浮きシェアバー（スマホ下部）を隠す */
	:global(html.cp-playing .rail-left) {
		visibility: hidden !important;
		pointer-events: none !important;
	}
	.cp-timetext b {
		display: inline-block;
		min-width: 2ch;
		text-align: right;
	}
	/* FINAL（最後のセクション）：残り時間を強調 */
	.is-final .cp-timebar i {
		background: var(--pink);
	}
	.is-final .cp-timetext b {
		color: var(--pink);
		font-weight: 800;
	}

	.cp-stage {
		position: relative;
		width: 100%;
		height: min(70vh, 560px);
		min-height: 320px;
	}
	.cp-stage canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		cursor: pointer;
		touch-action: manipulation;
	}
	/* 外部音源のクレジット（小さく・盤面の下） */
	.cp-credit {
		margin: 0;
		padding: 0 20px 10px;
		font-size: 0.75rem;
		color: var(--chalk);
		opacity: 0.75;
		text-align: right;
	}
	/* リンクは JS で作るのでスコープ外（:global）。盤面の色に合わせる */
	.cp-credit :global(a) {
		color: inherit;
		text-underline-offset: 2px;
	}

	/* TAP TO START オーバーレイ */
	.cp-start {
		position: absolute;
		inset: 0;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(20, 26, 22, 0.8); /* 静止プレビューの振り子が文字に被っても読めるように */
		z-index: 2;
	}
	.cp-start[hidden] {
		display: none;
	}
	.cp-start-inner {
		text-align: center;
		color: var(--chalk);
		padding: 1rem;
	}
	.cp-start-title {
		font-size: clamp(1.6rem, 6vw, 2.4rem);
		font-weight: 700;
		letter-spacing: 0.08em;
		margin: 0 0 0.3em;
	}
	.cp-start-btn {
		font: inherit;
		font-weight: 800;
		font-size: 1.15rem;
		background: var(--yellow);
		color: var(--board-deep);
		border: none;
		border-radius: 999px;
		padding: 14px 40px;
		cursor: pointer;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
	}
	.cp-start-btn:focus-visible {
		outline: 3px solid #ffffff;
		outline-offset: 3px;
	}
	.cp-start-sound {
		margin: 0 0 0.7em;
		font-size: 0.85rem;
		opacity: 0.85;
	}
	/* モード切替（QUICK / FULL）。選んでいる方を黄色に */
	.cp-mode {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin: 0 0 0.8em;
	}
	.cp-mode-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 7.5em;
		padding: 0.35em 0.9em;
		border: 1.5px solid var(--chalk-dim);
		border-radius: 12px;
		color: var(--chalk);
		text-decoration: none;
		line-height: 1.2;
	}
	.cp-mode-btn b {
		font-size: 0.95rem;
		letter-spacing: 0.08em;
	}
	.cp-mode-btn small {
		font-size: 0.72rem;
		opacity: 0.8;
	}
	.cp-mode-btn.active {
		border-color: var(--yellow);
		color: var(--yellow);
		background: rgba(242, 208, 107, 0.1);
	}
	.cp-mode-btn:focus-visible {
		outline: 3px solid var(--yellow);
		outline-offset: 2px;
	}
	/* 何をすればいいかを1つだけ大きく：「ドン！でタップ」 */
	.cp-start-rule {
		margin: 0 0 1.1em;
		line-height: 1.35;
	}
	.cp-start-ticks {
		display: block;
		font-size: 1rem;
		opacity: 0.75;
		letter-spacing: 0.04em;
	}
	.cp-start-don {
		display: block;
		font-size: clamp(1.5rem, 6.5vw, 2rem);
		font-weight: 800;
	}
	.cp-start-don b {
		color: var(--yellow);
	}
	/* ゲーム中の最小説明：盤面下端に小さく。開始から約6秒で消える（操作は透過） */
	.cp-play-hint {
		position: absolute;
		left: 50%;
		bottom: 12px;
		transform: translateX(-50%);
		margin: 0;
		padding: 4px 14px;
		border-radius: 999px;
		background: rgba(20, 26, 22, 0.6);
		color: var(--chalk);
		font-size: 0.9rem;
		font-weight: 700;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.6s ease;
	}
	.cp-play-hint b {
		color: var(--yellow);
	}
	.cp-play-hint.show {
		opacity: 1;
	}
	@media (prefers-reduced-motion: reduce) {
		.cp-play-hint {
			transition: none;
		}
	}
	.cp-start-hint {
		font-size: 0.8rem;
		opacity: 0.7;
		margin: 0.9em 0 0;
	}

	.cp-footer {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		padding: 12px 20px 14px;
	}
	.cp-footer p {
		margin: 0;
		font-size: 1rem;
		min-height: 1.5em;
		max-width: 60ch;
		color: var(--chalk);
	}

	/* 結果パネル */
	.cp-result {
		margin-top: 1.2rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1.1rem 1.2rem 1.3rem;
		background: #fbfbfa;
	}
	.cp-result-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.15rem;
	}
	.cp-result-head p {
		margin: 0;
	}
	.cp-finish {
		font-size: 0.9rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: rgb(var(--gray));
	}
	.cp-score-value {
		font-variant-numeric: tabular-nums;
		line-height: 1.1;
	}
	.cp-score-value b {
		font-size: clamp(2.4rem, 11vw, 3.2rem);
		color: var(--accent);
	}
	.cp-score-unit {
		font-size: 1rem;
		font-weight: 700;
		margin-left: 0.15em;
		color: rgb(var(--gray-dark));
	}
	/* 結果発表の各項目（順番に出る） */
	.cp-res-stats {
		list-style: none;
		margin: 0.5rem auto 0.2rem;
		padding: 0;
		width: min(100%, 300px);
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.cp-res-stats li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		font-weight: 700;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
		border-bottom: 1px dashed rgb(var(--gray-light));
		padding: 0.15rem 0;
	}
	.cp-res-stats b {
		font-size: 1.15rem;
		font-variant-numeric: tabular-nums;
		color: #222222;
	}
	.cp-res-chaos span,
	.cp-res-chaos b {
		color: #1f7f97;
	}
	.cp-reveal {
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.18s ease,
			transform 0.18s ease;
	}
	.cp-reveal.shown {
		opacity: 1;
		transform: none;
	}
	/* ランクのハンコ */
	.cp-rank {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.5rem 0 0.1rem !important;
	}
	.cp-rank-label {
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		color: rgb(var(--gray));
	}
	.cp-rank-letter {
		display: inline-grid;
		place-items: center;
		width: 3.2rem;
		height: 3.2rem;
		border-radius: 50%;
		border: 4px solid currentColor;
		font-size: 2rem;
		font-weight: 900;
		line-height: 1;
		transform: rotate(-8deg);
	}
	.cp-rank-letter[data-rank='S'] {
		color: #c9971a;
	}
	.cp-rank-letter[data-rank='A'] {
		color: #b0476a;
	}
	.cp-rank-letter[data-rank='B'] {
		color: #2f6f8a;
	}
	.cp-rank-letter[data-rank='C'] {
		color: #6b6b6b;
	}
	.cp-rank.shown .cp-rank-letter {
		animation: cp-stamp 0.32s cubic-bezier(0.2, 1.4, 0.4, 1);
	}
	@keyframes cp-stamp {
		from {
			transform: rotate(-8deg) scale(2.2);
			opacity: 0;
		}
		to {
			transform: rotate(-8deg) scale(1);
			opacity: 1;
		}
	}
	.cp-newbest-diff {
		margin-left: 0.4em;
		font-variant-numeric: tabular-nums;
	}
	.cp-newbest-up {
		margin-left: 0.5em;
		padding: 1px 8px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.22);
		font-variant-numeric: tabular-nums;
	}
	.cp-newcombo {
		font-size: 0.85rem;
		font-weight: 700;
		color: #b0476a;
	}
	/* NEXT GOAL：次の1プレイで狙うこと（1つだけ） */
	.cp-next-goal {
		margin-top: 0.45rem !important;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.1rem;
		padding: 0.45rem 1.2rem 0.55rem;
		border: 2px solid var(--accent);
		border-radius: 12px;
		color: var(--accent);
	}
	.cp-next-label {
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		opacity: 0.8;
	}
	.cp-next-text {
		font-size: 1.1rem;
		font-variant-numeric: tabular-nums;
	}
	/* あと少し（〜300点）：黄色で強調して脈打つ */
	.cp-next-goal.close {
		border-color: #d9a400;
		background: #fff7d6;
		color: #8a6400;
		animation: cp-close 1s ease-in-out infinite;
	}
	.cp-next-goal.close .cp-next-text {
		font-size: 1.3rem;
	}
	.cp-so-close {
		font-size: 0.95rem;
		font-weight: 900;
		letter-spacing: 0.08em;
		color: #d98200;
	}
	@keyframes cp-close {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.04);
		}
	}
	/* S ランクだけ特別：金のグラデーション＋光の帯 */
	.cp-rank-letter[data-rank='S'] {
		color: #fff8dc;
		border-color: #e6b422;
		background: radial-gradient(circle at 35% 30%, #ffe38a, #e0a800 70%);
		box-shadow:
			0 0 0 3px #fff3c4,
			0 0 18px rgba(230, 180, 34, 0.75);
		text-shadow: 0 1px 2px rgba(120, 80, 0, 0.6);
		position: relative;
		overflow: hidden;
	}
	.cp-rank.shown .cp-rank-letter[data-rank='S']::after {
		content: '';
		position: absolute;
		inset: -20%;
		background: linear-gradient(115deg, transparent 40%, rgba(255, 255, 255, 0.85) 50%, transparent 60%);
		animation: cp-shine 1.2s 0.3s ease-out;
		transform: translateX(-120%);
	}
	@keyframes cp-shine {
		to {
			transform: translateX(120%);
		}
	}
	.cp-first-s {
		font-size: 0.95rem;
		font-weight: 900;
		letter-spacing: 0.1em;
		color: #c9971a;
	}
	@media (prefers-reduced-motion: reduce) {
		.cp-reveal {
			transition: none;
		}
		.cp-rank.shown .cp-rank-letter,
		.cp-next-goal.close,
		.cp-rank.shown .cp-rank-letter[data-rank='S']::after {
			animation: none;
		}
	}
	.cp-best-line {
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.cp-best-line b {
		margin-left: 0.4em;
		font-variant-numeric: tabular-nums;
	}
	.cp-newbest {
		margin: 0.35rem 0 0.1rem !important;
		font-weight: 800;
		font-size: 0.95rem;
		color: #ffffff;
		background: var(--accent);
		border-radius: 999px;
		padding: 6px 16px;
		animation: cp-pop 0.35s ease;
	}
	@media (prefers-reduced-motion: reduce) {
		.cp-newbest {
			animation: none;
		}
	}
	@keyframes cp-pop {
		from {
			transform: scale(0.6);
			opacity: 0;
		}
		to {
			transform: scale(1);
			opacity: 1;
		}
	}

	/* ランキング登録は副導線（リトライの下・控えめ） */
	.cp-submit {
		margin-top: 1.3rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.cp-submit-head {
		margin: 0 0 0.5rem;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.cp-submit-row {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.cp-submit-row input {
		flex: 1 1 12rem;
		min-width: 0;
		font: inherit;
		font-size: 1rem;
		padding: 10px 12px;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
	}
	/* 副導線：もう一回（塗り）より控えめな枠線ボタン */
	.cp-submit-btn {
		font: inherit;
		font-weight: 700;
		background: #ffffff;
		color: var(--accent);
		border: 2px solid var(--accent);
		border-radius: 8px;
		padding: 8px 18px;
		min-height: 44px;
		cursor: pointer;
	}
	.cp-submit-btn:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}
	.cp-submit-btn:disabled {
		background: rgb(var(--gray-light));
		border-color: rgb(var(--gray-light));
		color: #888888;
		cursor: not-allowed;
	}
	.cp-submit-status {
		margin: 0.6rem 0 0;
		min-height: 1.3em;
		font-weight: 600;
		color: #333333;
	}

	/* もう一回：結果画面の主ボタン（大きく・アクセント色） */
	.cp-again {
		margin-top: 1.2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
	}
	.cp-retry-hint {
		font-size: 0.8rem;
		color: rgb(var(--gray));
	}
	.cp-mode-link {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
	}
	.cp-submit-off {
		margin: 1.3rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.85rem;
		color: rgb(var(--gray));
		text-align: center;
	}
	.cp-res-song {
		margin: 0.1rem 0 0;
		font-size: 0.85rem;
		font-weight: 700;
		color: rgb(var(--gray));
	}
	.cp-again-btn {
		font: inherit;
		font-weight: 800;
		font-size: 1.25rem;
		background: var(--accent);
		color: #ffffff;
		border: none;
		border-radius: 999px;
		padding: 15px 64px;
		cursor: pointer;
		box-shadow: 0 6px 18px rgba(0, 13, 138, 0.22);
		transition:
			transform 0.12s ease,
			box-shadow 0.12s ease;
	}
	.cp-again-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 26px rgba(0, 13, 138, 0.3);
	}
	.cp-again-btn:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}

	/* ランキング */
	.cp-ranking {
		margin-top: 1.4rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1rem 1.2rem 1.2rem;
	}
	.cp-ranking-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		flex-wrap: wrap;
	}
	.cp-ranking-head h3 {
		margin: 0;
		font-size: 1.15rem;
	}
	.cp-tabs {
		display: flex;
		gap: 0.35rem;
	}
	.cp-tab {
		font: inherit;
		font-size: 0.9rem;
		background: transparent;
		color: rgb(var(--gray));
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		padding: 5px 14px;
		cursor: pointer;
	}
	.cp-tab.active {
		background: var(--accent);
		color: #ffffff;
		border-color: var(--accent);
	}

	/* ランキングの難易度タブ */
	.cp-rank-diffs {
		display: flex;
		gap: 0.35rem;
		margin: 0.9rem 0 0.2rem;
		flex-wrap: wrap;
	}
	.cp-difftab {
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		background: transparent;
		color: rgb(var(--gray));
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		padding: 4px 14px;
		cursor: pointer;
	}
	.cp-difftab.active {
		background: var(--accent);
		color: #ffffff;
		border-color: var(--accent);
	}
	.cp-difftab[data-rank-diff='oni'].active {
		background: #ee93a8;
		border-color: #ee93a8;
	}

	/* 見出し行と各行で同じ固定カラムを使い、列をきっちり揃える */
	.cp-rank-header,
	.cp-rank-list li {
		display: grid;
		grid-template-columns: 3.2rem 1fr 5rem 4rem;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.2rem;
	}
	.cp-rank-header {
		padding-top: 0.2rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid rgb(var(--gray-light));
		font-size: 0.75rem;
		font-weight: 700;
		color: rgb(var(--gray));
	}
	.cp-rank-header .rk,
	.cp-rank-header .sc,
	.cp-rank-header .cb {
		text-align: right;
	}
	.cp-rank-list li {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.cp-rank-list .rk {
		font-weight: 700;
		color: var(--accent);
		text-align: right;
	}
	.cp-rank-list .nm {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.cp-rank-list .sc {
		font-weight: 700;
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.cp-rank-list .cb {
		text-align: right;
		color: var(--pink, #c2568a);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.cp-rank-status {
		margin: 0.8rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}

	@media (max-width: 520px) {
		/* スマホ：ページ見出しと重複するタイトルを隠し、HUD と難易度を詰めて盤面をすぐ見せる */
		.cp-title {
			display: none;
		}
		.cp-header {
			padding: 10px 12px 0;
		}
		.cp-head-right {
			width: 100%;
			justify-content: space-between;
			gap: 8px;
		}
		.cp-stats {
			gap: 12px;
			font-size: 0.9rem;
		}
		.cp-mute {
			padding: 4px 10px;
			font-size: 0.8rem;
		}
		.cp-diff {
			padding: 8px 12px 0;
		}
		.cp-diff-label {
			display: none;
		}
		.cp-diff-btns {
			width: 100%;
			flex-wrap: nowrap;
		}
		.cp-diff-btn {
			flex: 1 1 0;
			padding: 6px 0;
			font-size: 0.85rem;
		}
		.cp-stage {
			height: min(60vh, 520px);
		}
		/* スタート画面は盤面の上寄せ：スマホの初期表示で TAP TO START まで見えるように */
		.cp-start {
			align-items: flex-start;
			padding-top: 14px;
		}
		.cp-start-title {
			font-size: 1.35rem;
			margin-bottom: 0.2em;
		}
			.cp-timebar {
