---
// CHAOS BEAT — ゲーム UI（DOM + スタイル）と各モジュールの統合点。
// ゲームロジックは src/scripts/games/chaos-pendulum.ts の initGame()（物理は不変）。
// このコンポーネントが、エンジンの onEvent を analytics/audio/storage/ranking へ橋渡しする。
---

<div class="cp-wrap" data-cp-root>
	<div class="cp-game">
		<header class="cp-header">
			<h2 class="cp-title">CHAOS BEAT</h2>
			<div class="cp-head-right">
				<div class="cp-stats">
					<span>SCORE <b data-cp-score>0</b></span>
					<span>COMBO <b data-cp-combo>0</b></span>
					<span class="cp-timetext">TIME <b data-cp-timetext>60</b></span>
				</div>
				<button type="button" class="cp-mute" data-cp-mute aria-pressed="false" title="効果音のオン/オフ">
					🔊 音オン
				</button>
			</div>
		</header>
		<div class="cp-diff" role="group" aria-label="難易度を選ぶ">
			<span class="cp-diff-label">難易度</span>
			<div class="cp-diff-btns">
				<button type="button" class="cp-diff-btn" data-diff="easy">易しい</button>
				<button type="button" class="cp-diff-btn active" data-diff="normal">普通</button>
				<button type="button" class="cp-diff-btn" data-diff="hard">難しい</button>
				<button type="button" class="cp-diff-btn" data-diff="oni">鬼</button>
			</div>
		</div>
		<div class="cp-timebar" aria-hidden="true"><i data-cp-time></i></div>
		<div class="cp-stage">
			<canvas data-cp-canvas aria-label="二重振り子のゲーム画面"></canvas>
			<!-- ゲーム中の最小説明（開始後しばらくで消える。操作の邪魔をしない） -->
			<p class="cp-play-hint" data-cp-play-hint aria-hidden="true"><b>ドン！</b>でタップ</p>
			<div class="cp-start" data-cp-start>
				<div class="cp-start-inner">
					<p class="cp-start-title">CHAOS BEAT</p>
					<!-- モード：QUICK（60秒・合成BGM・ランキングあり）/ FULL（Burning Heart 1曲まるごと）。ページを切り替える -->
					<p class="cp-mode" data-cp-mode role="group" aria-label="モードを選ぶ">
						<a class="cp-mode-btn" href="?" data-mode="normal60"><b>QUICK</b><small>60秒</small></a>
						<a class="cp-mode-btn" href="?song=burning-heart" data-mode="burning-heart"><b>FULL</b><small>Burning Heart 5:00</small></a>
					</p>
					<p class="cp-start-sound">🔊 音あり推奨</p>
					<p class="cp-start-rule">
						<span class="cp-start-ticks">タン・タン・タン・</span>
						<span class="cp-start-don"><b>ドン！</b>でタップ</span>
					</p>
					<button type="button" class="cp-start-btn" data-cp-start-btn>▶ TAP TO START</button>
					<p class="cp-start-hint" data-cp-start-hint>タップ / クリック / Space ・ 1プレイ約60秒</p>
				</div>
			</div>
		</div>
		<footer class="cp-footer">
			<p data-cp-msg aria-live="polite">
				「ドン！」の瞬間にタップ（PC はスペース）。振り子の先端が黄色い丸に重なるほど高得点。
			</p>
		</footer>
		<!-- 外部音源の曲のクレジット（曲に credit があるときだけ表示） -->
		<p class="cp-credit" data-cp-credit hidden></p>
	</div>

	<!-- 結果パネル（1曲60秒の終了後に表示） -->
	<section class="cp-result" data-cp-result hidden aria-live="polite">
		<!-- 結果発表：スコア高速加算 → PERFECT → CHAOS PERFECT → MAX COMBO → FEVER → ランク → NEW BEST → あと◯点で次のランク。
		     「もう一回！」は演出を待たずに最初から押せる（再戦の邪魔をしない） -->
		<div class="cp-result-head">
			<p class="cp-finish">FINISH!</p>
			<p class="cp-res-song" data-cp-res-song hidden></p>
			<p class="cp-score-value"><b data-cp-final>0</b><span class="cp-score-unit">点</span></p>
			<ul class="cp-res-stats">
				<li class="cp-reveal" data-cp-reveal><span>PERFECT</span><b data-cp-st-perfect>0</b></li>
				<li class="cp-reveal cp-res-chaos" data-cp-reveal><span>⚡ CHAOS PERFECT</span><b data-cp-st-chaos>0</b></li>
				<li class="cp-reveal" data-cp-reveal><span>MAX COMBO</span><b data-cp-final-combo>0</b></li>
				<li class="cp-reveal" data-cp-reveal><span>🔥 FEVER</span><b data-cp-st-fever>0秒</b></li>
			</ul>
			<p class="cp-first-s" data-cp-first-s hidden>FIRST S RANK!</p>
			<p class="cp-rank cp-reveal" data-cp-rank-wrap>
				<span class="cp-rank-label">RANK</span><b class="cp-rank-letter" data-cp-rank>C</b>
			</p>
			<p class="cp-newbest" data-cp-newbest hidden>
				NEW BEST! <span class="cp-newbest-diff" data-cp-best-diff></span>
				<span class="cp-newbest-up" data-cp-best-up></span>
			</p>
			<p class="cp-newcombo" data-cp-newcombo hidden></p>
			<!-- NEXT GOAL：次の1プレイで狙うことを1つだけ（次のランク → 自己ベスト → 最大コンボ） -->
			<p class="cp-next-goal" data-cp-next hidden>
				<span class="cp-next-label">NEXT GOAL</span>
				<span class="cp-so-close" data-cp-close hidden>SO CLOSE!</span>
				<b class="cp-next-text" data-cp-next-text></b>
			</p>
			<p class="cp-best-line">自己ベスト（この難易度）<b data-cp-best>0</b></p>
		</div>

		<div class="cp-again">
			<button type="button" class="cp-again-btn" data-cp-again>もう一回！</button>
			<span class="cp-retry-hint">スペースキーでも、もう一回</span>
			<a class="cp-mode-link" data-cp-mode-link href="?song=burning-heart">▶ FULL（Burning Heart・約5分）に挑戦</a>
		</div>

		<p class="cp-submit-off" data-cp-submit-off hidden>FULL はランキング対象外です（自己ベストは曲ごとに記録されます）</p>
		<div class="cp-submit" data-cp-submit-wrap>
			<p class="cp-submit-head">スコアをランキングに残す（任意）</p>
			<div class="cp-submit-row">
				<input
					id="cp-nick"
					type="text"
					data-cp-nick
					maxlength="20"
					placeholder="名無し"
					autocomplete="off"
				/>
				<button type="button" class="cp-submit-btn" data-cp-submit>ランキングに入れる</button>
			</div>
			<p class="cp-submit-status" data-cp-submit-status aria-live="polite"></p>
		</div>
	</section>

	<!-- ページ側の「遊び方・FEVER」をゲームとランキングの間に差し込む（ランキングは説明より下） -->
	<slot name="guide" />

	<!-- ランキング -->
	<section class="cp-ranking" data-cp-ranking id="ranking">
		<div class="cp-ranking-head">
			<h3>ランキング</h3>
			<div class="cp-tabs" role="tablist">
				<button type="button" class="cp-tab active" data-period="daily">今日</button>
				<button type="button" class="cp-tab" data-period="weekly">今週</button>
				<button type="button" class="cp-tab" data-period="all">歴代</button>
			</div>
		</div>
		<div class="cp-rank-diffs" role="tablist" aria-label="ランキングの難易度">
			<button type="button" class="cp-difftab" data-rank-diff="easy">易しい</button>
			<button type="button" class="cp-difftab active" data-rank-diff="normal">普通</button>
			<button type="button" class="cp-difftab" data-rank-diff="hard">難しい</button>
			<button type="button" class="cp-difftab" data-rank-diff="oni">鬼</button>
		</div>
		<div class="cp-rank-header" data-cp-rank-header hidden>
			<span class="rk">順位</span>
			<span class="nm">名前</span>
			<span class="sc">スコア</span>
			<span class="cb">コンボ</span>
		</div>
		<ol class="cp-rank-list" data-cp-rank-list></ol>
		<p class="cp-rank-status" data-cp-rank-status>ゲームを遊ぶとランキングが表示されます。</p>
	</section>
</div>

<script>
	import {
		initGame,
		type Difficulty,
		type GameEventName,
		type GameEventPayloads,
	} from '../../scripts/games/chaos-pendulum';
	import { trackGameEvent } from '../../scripts/games/analytics';
	import { createAudio } from '../../scripts/games/audio';
	import { COUNTIN_BEATS } from '../../scripts/games/beat-grid';
	import { DEFAULT_SONG, SONGS, type SongDefinition } from '../../scripts/games/song';
	import { updateBest } from '../../scripts/games/storage';
	import { nextGoal, rankOf, type NextGoal, type ResultRank } from '../../scripts/games/result-rank';
	import {
		getRanking,
		submitScore,
		type RankingEntry,
		type RankingPeriod,
	} from '../../scripts/games/ranking';

	// 遊ぶ曲：既定は内蔵の合成BGM曲。?song=<id> で外部音源の曲を試せる（曲選択 UI はまだ無い）
	const urlParams = new URLSearchParams(location.search);
	const BASE_SONG = SONGS[urlParams.get('song') ?? ''] ?? DEFAULT_SONG;
	const IS_DEFAULT_SONG = BASE_SONG === DEFAULT_SONG;
	const DEBUG = urlParams.get('debug') === '1';
	/**
	 * 同期の調整用（?debug=1 のときだけ）：外部音源の曲の bpm / offset / startAt を URL で上書きできる。
	 * 例：?song=external_test&debug=1&offset=0.183 → メトロノーム四角と曲のキックが揃う値を探して song.ts に書き戻す。
	 */
	const num = (k: string) => {
		const v = urlParams.get(k);
		return v != null && v !== '' && Number.isFinite(Number(v)) ? Number(v) : undefined;
	};
	const SONG: SongDefinition =
		DEBUG && BASE_SONG.audio
			? {
					...BASE_SONG,
					bpm: num('bpm') ?? BASE_SONG.bpm,
					audio: {
						...BASE_SONG.audio,
						offset: num('offset') ?? BASE_SONG.audio.offset,
						startAt: num('startAt') ?? BASE_SONG.audio.startAt,
					},
				}
			: BASE_SONG;
	/** 自己ベストのキー：内蔵曲は従来どおり、外部音源の曲は曲 id ごと */
	const SONG_KEY = IS_DEFAULT_SONG ? undefined : SONG.id;

	const root = document.querySelector<HTMLElement>('[data-cp-root]');
	if (root) {
		const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);

		const canvas = q<HTMLCanvasElement>('[data-cp-canvas]');
		const scoreEl = q('[data-cp-score]');
		const comboEl = q('[data-cp-combo]');
		const timeEl = q('[data-cp-time]');
		const timeTextEl = q('[data-cp-timetext]');
		const msg = q('[data-cp-msg]');
		const muteBtn = q<HTMLButtonElement>('[data-cp-mute]');
		const startOverlay = q('[data-cp-start]');
		const startBtn = q<HTMLButtonElement>('[data-cp-start-btn]');
		const resultPanel = q('[data-cp-result]');
		const finalEl = q('[data-cp-final]');
		const finalComboEl = q('[data-cp-final-combo]');
		const bestEl = q('[data-cp-best]');
		const newBestBadge = q('[data-cp-newbest]');
		const bestDiffEl = q('[data-cp-best-diff]');
		const statPerfectEl = q('[data-cp-st-perfect]');
		const statChaosEl = q('[data-cp-st-chaos]');
		const statFeverEl = q('[data-cp-st-fever]');
		const rankEl = q('[data-cp-rank]');
		const nextRankEl = q('[data-cp-next]');
		const nextTextEl = q('[data-cp-next-text]');
		const soCloseEl = q('[data-cp-close]');
		const bestUpEl = q('[data-cp-best-up]');
		const newComboEl = q('[data-cp-newcombo]');
		const firstSEl = q('[data-cp-first-s]');
		const revealEls = Array.from(root.querySelectorAll<HTMLElement>('[data-cp-reveal], [data-cp-rank-wrap]'));
		const nickInput = q<HTMLInputElement>('[data-cp-nick]');
		const submitBtn = q<HTMLButtonElement>('[data-cp-submit]');
		const againBtn = q<HTMLButtonElement>('[data-cp-again]');
		const submitStatus = q('[data-cp-submit-status]');
		const rankList = q<HTMLOListElement>('[data-cp-rank-list]');
		const rankHeader = q('[data-cp-rank-header]');
		const rankStatus = q('[data-cp-rank-status]');
		const rankTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-period]'));
		const rankDiffTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rank-diff]'));
		const diffBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-diff]'));

		if (canvas && scoreEl && comboEl && timeEl && msg) {
			const audio = createAudio();
			audio.preloadSong(SONG); // 外部音源なら取得だけ先に始める（デコードは初回スタート時。以後キャッシュ）
			// --- モード（QUICK / FULL）の表示 ---
			const IS_FULL = SONG.duration >= 100;
			const fmtClock = (sec: number) => `${Math.floor(sec / 60)}:${String(Math.round(sec) % 60).padStart(2, '0')}`;
			root.querySelectorAll<HTMLAnchorElement>('[data-mode]').forEach((a) => {
				const on = a.dataset.mode === SONG.id || (IS_DEFAULT_SONG && a.dataset.mode === DEFAULT_SONG.id);
				a.classList.toggle('active', on);
				if (on) a.setAttribute('aria-current', 'true');
				// オーバーレイ全体が TAP TO START なので、モード切替のリンクは開始のクリックに伝えない
				a.addEventListener('click', (e) => e.stopPropagation());
			});
			const startHint = q('[data-cp-start-hint]');
			if (IS_FULL) {
				if (startHint) startHint.textContent = `♪ ${SONG.title}（フル尺 ${fmtClock(SONG.duration)}）・ タップ / クリック / Space`;
				if (timeTextEl) timeTextEl.textContent = fmtClock(SONG.duration);
			}
			const resSongEl = q('[data-cp-res-song]');
			if (resSongEl && !IS_DEFAULT_SONG) {
				resSongEl.hidden = false;
				resSongEl.textContent = `♪ ${SONG.title}${SONG.modeLabel ? ` ・ ${SONG.modeLabel}` : ''}`;
			}
			const modeLink = q<HTMLAnchorElement>('[data-cp-mode-link]');
			if (modeLink && !IS_DEFAULT_SONG) {
				modeLink.href = '?';
				modeLink.textContent = '◀ QUICK（60秒）に戻る';
			}
			// ランキングは内蔵の60秒曲のみ（外部音源の曲は送らない）。登録欄の代わりに一言
			if (!IS_DEFAULT_SONG) {
				const wrap = q('[data-cp-submit-wrap]');
				if (wrap) wrap.hidden = true;
				const off = q('[data-cp-submit-off]');
				if (off) {
					off.hidden = false;
					if (!IS_FULL) off.textContent = 'この曲はランキングの対象外です（テスト曲）';
				}
			}

			const creditEl = q('[data-cp-credit]');
			if (creditEl && SONG.credit) {
				creditEl.hidden = false;
				if (SONG.credit.url) {
					const a = document.createElement('a');
					a.href = SONG.credit.url;
					a.target = '_blank';
					a.rel = 'noopener';
					a.textContent = SONG.credit.label;
					creditEl.append(a);
				} else {
					creditEl.textContent = SONG.credit.label;
				}
			}

			// --- ミュートボタン ---
			const renderMute = () => {
				if (!muteBtn) return;
				const m = audio.isMuted();
				muteBtn.textContent = m ? '🔇 音オフ' : '🔊 音オン';
				muteBtn.setAttribute('aria-pressed', String(m));
			};
			renderMute();
			muteBtn?.addEventListener('click', () => {
				const m = audio.toggleMute();
				renderMute();
				trackGameEvent('sound_toggle', { muted: m });
			});

			// --- ランキング表示 ---
			let currentPeriod: RankingPeriod = 'daily';
			let currentDifficulty: Difficulty = 'normal'; // 今プレイしている難易度
			let rankDifficulty: Difficulty = 'normal'; // 今ランキングで見ている難易度
			let rankingViewed = false;

			const setRankDiffTab = (level: Difficulty) => {
				rankDiffTabs.forEach((b) => b.classList.toggle('active', b.dataset.rankDiff === level));
			};

			const renderRanking = (entries: RankingEntry[]) => {
				if (!rankList) return;
				rankList.replaceChildren();
				for (const e of entries) {
					const li = document.createElement('li');
					const rk = document.createElement('span');
					rk.className = 'rk';
					rk.textContent = `${e.rank}位`;
					const nm = document.createElement('span');
					nm.className = 'nm';
					nm.textContent = e.nickname; // textContent なので XSS 安全
					const sc = document.createElement('span');
					sc.className = 'sc';
					sc.textContent = `${e.score}`;
					const cb = document.createElement('span');
					cb.className = 'cb';
					cb.textContent = `${e.maxCombo}`;
					li.append(rk, nm, sc, cb);
					rankList.append(li);
				}
			};

			const loadRanking = async (period: RankingPeriod) => {
				if (rankStatus) rankStatus.textContent = '読み込み中…';
				try {
					const entries = await getRanking(period, rankDifficulty);
					renderRanking(entries);
					if (rankHeader) rankHeader.hidden = entries.length === 0;
					if (rankStatus) rankStatus.textContent = entries.length ? '' : 'まだ記録がありません。';
				} catch {
					if (rankList) rankList.replaceChildren();
					if (rankHeader) rankHeader.hidden = true;
					if (rankStatus) rankStatus.textContent = 'ランキングを取得できませんでした';
				}
			};

			rankTabs.forEach((btn) =>
				btn.addEventListener('click', () => {
					const p = (btn.dataset.period as RankingPeriod) ?? 'daily';
					currentPeriod = p;
					rankTabs.forEach((b) => b.classList.toggle('active', b === btn));
					trackGameEvent('ranking_view', { period: p, difficulty: rankDifficulty });
					loadRanking(p);
				}),
			);

			rankDiffTabs.forEach((btn) =>
				btn.addEventListener('click', () => {
					const level = (btn.dataset.rankDiff as Difficulty) ?? 'normal';
					rankDifficulty = level;
					setRankDiffTab(level);
					trackGameEvent('ranking_view', { period: currentPeriod, difficulty: level });
					loadRanking(currentPeriod);
				}),
			);

			// --- 登録用の状態 ---
			let lastResult: {
				difficulty: Difficulty;
				score: number;
				maxCombo: number;
				hits: number;
				perfectCount: number;
			} | null = null;
			let submitted = false;
			// ゲーム中の最小説明「ドン！でタップ」：開始（カウントイン）から約6秒だけ出して消す
			const playHint = q('[data-cp-play-hint]');
			let playHintTimer = 0;
			const showPlayHint = () => {
				if (!playHint) return;
				playHint.classList.add('show');
				window.clearTimeout(playHintTimer);
				playHintTimer = window.setTimeout(() => playHint.classList.remove('show'), 6000);
			};
			const REWARD_STAGE = 3;

			// --- 結果発表（60秒の報酬）：一瞬の無音 → スコア高速加算 → PERFECT → CHAOS PERFECT → MAX COMBO → FEVER →
			//     ランクのハンコ → NEW BEST（前 → 後）→「あと◯点で次のランク」。タップで飛ばせる。reduced-motion は一度に表示 ---
			type ResultData = {
				score: number;
				rank: ResultRank;
				isNewBest: boolean;
				isNewTopCombo: boolean;
				isFirstS: boolean;
				stamped: boolean;
				bested: boolean;
			};
			let resultData: ResultData | null = null;
			let resultTimers: number[] = [];
			let countRaf = 0;
			const fmt = (n: number) => n.toLocaleString('ja-JP');
			const cancelResultShow = () => {
				resultTimers.forEach((t) => window.clearTimeout(t));
				resultTimers = [];
				cancelAnimationFrame(countRaf);
			};
			const prepareResultShow = (
				g: GameEventPayloads['game_over'],
				rank: ResultRank,
				up: ReturnType<typeof updateBest>,
				goal: NextGoal,
			) => {
				cancelResultShow();
				const isNewBest = up.isNewBest;
				const prevBest = up.prevBestScore ?? 0;
				resultData = {
					score: g.score,
					rank,
					isNewBest,
					isNewTopCombo: up.isNewTopCombo,
					isFirstS: up.isFirstS,
					stamped: false,
					bested: false,
				};
				if (finalEl) finalEl.textContent = '0';
				if (statPerfectEl) statPerfectEl.textContent = String(g.perfectCount);
				if (statChaosEl) statChaosEl.textContent = g.chaosChances ? `${g.chaosPerfectCount} / ${g.chaosChances}` : '—';
				if (finalComboEl) finalComboEl.textContent = String(g.maxCombo);
				if (statFeverEl) statFeverEl.textContent = `${g.feverDuration.toFixed(1)}秒`;
				if (rankEl) {
					rankEl.textContent = rank;
					rankEl.dataset.rank = rank;
				}
				revealEls.forEach((el) => el.classList.remove('shown'));
				if (newBestBadge) newBestBadge.hidden = true;
				if (bestDiffEl) bestDiffEl.textContent = prevBest > 0 ? `${fmt(prevBest)} → ${fmt(g.score)}` : '初記録';
				if (bestUpEl) {
					bestUpEl.textContent = prevBest > 0 ? `+${fmt(g.score - prevBest)}` : ''; // 改善幅
					bestUpEl.hidden = prevBest <= 0; // 初記録では出さない
				}
				if (newComboEl) {
					newComboEl.hidden = true;
					newComboEl.textContent = `NEW MAX COMBO! ${up.prevTopCombo} → ${g.maxCombo}`;
				}
				if (firstSEl) firstSEl.hidden = true;
				if (nextRankEl) nextRankEl.hidden = true;
				if (nextTextEl) nextTextEl.textContent = goal.text;
				if (soCloseEl) soCloseEl.hidden = !goal.close;
				nextRankEl?.classList.toggle('close', goal.close);
				// 再戦ボタンの一言：あと少し／自己ベスト更新で変える（それ以外は「もう一回！」）
				if (againBtn) againBtn.textContent = goal.close ? 'あと少し！もう一回' : isNewBest && prevBest > 0 ? 'さらに更新する！' : 'もう一回！';
			};
			/** 残りを一度に表示（スキップ・reduced-motion・演出の最後） */
			const finishResultShow = (withSound: boolean) => {
				cancelResultShow();
				if (!resultData) return;
				if (finalEl) finalEl.textContent = fmt(resultData.score);
				revealEls.forEach((el) => el.classList.add('shown'));
				if (withSound && !resultData.stamped) audio.rankStamp(resultData.rank);
				if (resultData.isNewBest && newBestBadge) {
					newBestBadge.hidden = false;
					if (withSound && !resultData.bested) window.setTimeout(() => audio.best(), 350);
				}
				if (resultData.isNewTopCombo && newComboEl) newComboEl.hidden = false;
				if (resultData.isFirstS && firstSEl) firstSEl.hidden = false;
				if (nextRankEl) nextRankEl.hidden = false;
				resultData = null;
			};
			const playResultShow = () => {
				if (!resultData) return;
				const d = resultData;
				if (window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
					finishResultShow(true);
					return;
				}
				const at = (ms: number, fn: () => void) => resultTimers.push(window.setTimeout(fn, ms));
				const SILENCE = 250; // 一瞬の無音
				const COUNT = 900; // スコア高速加算
				at(SILENCE, () => {
					const t0 = performance.now();
					let lastTick = 0;
					const step = (now: number) => {
						const p = Math.min(1, (now - t0) / COUNT);
						const e = 1 - Math.pow(1 - p, 3);
						if (finalEl) finalEl.textContent = fmt(Math.round(d.score * e));
						if (now - lastTick > 65 && p < 1) {
							lastTick = now;
							audio.resultTick(p);
						}
						if (p < 1) countRaf = requestAnimationFrame(step);
					};
					countRaf = requestAnimationFrame(step);
				});
				const stats = revealEls.filter((el) => el.hasAttribute('data-cp-reveal'));
				stats.forEach((el, i) =>
					at(SILENCE + COUNT + 120 + i * 220, () => {
						el.classList.add('shown');
						audio.resultPop(i);
					}),
				);
				const rankAt = SILENCE + COUNT + 120 + stats.length * 220 + 250;
				at(rankAt, () => {
					revealEls.find((el) => el.hasAttribute('data-cp-rank-wrap'))?.classList.add('shown');
					d.stamped = true;
					audio.rankStamp(d.rank);
					if (d.isFirstS && firstSEl) firstSEl.hidden = false;
				});
				if (d.isNewBest || d.isNewTopCombo)
					at(rankAt + 550, () => {
						// 主役はスコアの NEW BEST。最大コンボ記録の更新は同時に小さく
						if (d.isNewBest && newBestBadge) newBestBadge.hidden = false;
						if (d.isNewTopCombo && newComboEl) newComboEl.hidden = false;
						d.bested = true;
						if (d.isNewBest) audio.best();
						else audio.resultPop(4);
					});
				// 最後に NEXT GOAL（合計 約3.3 秒以内）
				at(rankAt + (d.isNewBest || d.isNewTopCombo ? 950 : 500), () => finishResultShow(false));
			};
			// 結果の数字部分をタップしたら演出を飛ばして全部表示（ボタンはそのまま）
			root.querySelector('.cp-result-head')?.addEventListener('click', () => {
				if (resultData) finishResultShow(true);
			});
			let gameSerial = 0; // game_start ごとに増やす（遅延表示の取り消し用）
			const RESULT_DELAY_MS = 1300;
			const musicLevelOf = (combo: number) => (combo >= 10 ? 3 : combo >= 5 ? 2 : combo >= 3 ? 1 : 0);

			const handle = initGame({
				canvas,
				elements: { score: scoreEl, combo: comboEl, time: timeEl, timeText: timeTextEl, msg },
				song: SONG, // 曲（尺・BPM・セクション・譜面）。audio にも同じ曲を渡す＝同じ beat grid
				debugInfo: DEBUG ? () => audio.debugLines() : undefined, // ?debug=1 の同期確認表示
				difficulty: currentDifficulty,
				now: () => audio.now(), // 共通トランスポート時計（BGM/cue と同じ原点）
				// 押した瞬間＝入力イベントの時刻（event.timeStamp）を同じ transport 時刻に換算（ハンドラの遅れを判定に混ぜない）
				eventTime: (ts: number) => audio.eventTimeToTransport(ts),
				// ?debug=1：最後の入力の内訳を window.__cbLastInput に（検証用）
				onInputDebug: DEBUG
					? (info) => {
							(window as unknown as { __cbLastInput?: unknown }).__cbLastInput = info;
						}
					: undefined,
				autostart: false, // TAP TO START を待つ
				onEvent(name: GameEventName, payload: GameEventPayloads[GameEventName]) {
					const params = (payload as Record<string, unknown>) ?? {};
					// ゲーム単位のイベントには難易度を付けて送る（リトライ率・判定分布を難易度別に見るため）
					const perGame = name === 'game_start' || name === 'game_over' || name === 'game_retry';
					// reward_stage：報酬設計の段階（0=導入前 / 1=音階＋プツッ / 2=＋CHAOS PERFECT / 3=＋結果発表）。
					// 段階ごとに game_retry ÷ game_over（結果画面からの再戦率）を比べるための目印（古いキャッシュのプレイも分けられる）
					// game_over は結果（ランク・自己ベスト更新）を計算してから下で送る
					if (name !== 'game_over')
						trackGameEvent(
							name,
							perGame
								? { ...params, difficulty: currentDifficulty, reward_stage: REWARD_STAGE, song_id: SONG.id, audio_mode: audio.audioMode() }
								: params,
						);

					if (name === 'game_start') {
						cancelResultShow();
						showPlayHint();
						// プレイ中はスマホ下部に浮くシェアバーを隠す（盤面の下端に重なって誤タップしないように）
						document.documentElement.classList.add('cp-playing');
						submitted = false;
						gameSerial++;
						if (resultPanel) resultPanel.hidden = true;
						root.classList.remove('is-final');
					}

					if (name === 'section_change') {
						const p = payload as GameEventPayloads['section_change'];
						// FINAL は残り時間表示・バーを強調（キャンバス側は 5→1 カウント＋枠の明滅）
						root.classList.toggle('is-final', p.section === 'final');
					}

					if (name === 'hit') {
						const p = payload as GameEventPayloads['hit'];
						audio.stopChaosTell(); // 叩いた・見逃した瞬間に予兆音を止める
						audio.judgment(p.kind, p.combo); // コンボで音階が上がる／切れたら「プツッ」
						if (p.chaosPerfect) {
							audio.chaosPerfect(); // ⚡ 振り子が最も荒れた瞬間を叩き抜いた
							try {
								navigator.vibrate?.([15, 30, 45]);
							} catch {
								/* 非対応は無視 */
							}
						}
						audio.setMusicLevel(musicLevelOf(p.combo)); // コンボで層が増減（MISSでcombo0→drumだけ）
					}

					if (name === 'rhythm_pattern') {
						const p = payload as GameEventPayloads['rhythm_pattern'];
						// transport 時刻（beatTime）で予約＝BGMの拍頭と同じ式。CHAOS チャンスなら hitTime 直前に予兆音も
						audio.scheduleRhythm(p.cues, p.chaos ? { hitTime: p.hitTime, tell: p.chaosTell } : undefined);
					}

					if (name === 'fever_start') {
						audio.setFever(true); // 次の拍頭からクラッシュ＋FEVER 層（lead/パッド/オクターブ）
						audio.fever(); // 突入SE（インパクト＋ライザー＋スパークル）
						try {
							navigator.vibrate?.([25, 40, 60]); // 対応端末だけ軽く「ドドン」
						} catch {
							/* 非対応は無視 */
						}
					}

					if (name === 'fever_end') {
						const p = payload as GameEventPayloads['fever_end'];
						audio.setFever(false); // 次の拍から FEVER 層が消える（MISS なら combo0 で基本アレンジだけに）
						// 曲の終止まで FEVER を保った場合は解除音を鳴らさない（そのまま最も派手な終止音へ）
						if (p.reason === 'miss') audio.feverEnd();
						else if (p.reason === 'timeout') audio.resultPop(3); // 時間切れは「やり切った」：小さな明るい音
					}

					if (name === 'game_over') {
						const g = payload as GameEventPayloads['game_over'];
						audio.stopMusic(); // BGMを短くフェードアウト
						// 難易度は「プレイした時点のもの」を固定（この後タブを触っても送信は不変）
						lastResult = {
							difficulty: currentDifficulty,
							score: g.score,
							maxCombo: g.maxCombo,
							hits: g.hits,
							perfectCount: g.perfectCount,
						};

						const rank = rankOf(g.score, currentDifficulty, SONG_KEY); // FULL は曲専用のランク基準
						const up = updateBest({ score: g.score, maxCombo: g.maxCombo, rank }, currentDifficulty, SONG_KEY);
						const isNewBest = up.isNewBest;
						const goal = nextGoal({
							score: g.score,
							difficulty: currentDifficulty,
							isNewBest,
							bestScore: up.best.bestScore,
							topCombo: up.best.topCombo,
							songId: SONG_KEY,
						});
						trackGameEvent('game_over', {
							...(payload as Record<string, unknown>),
							difficulty: currentDifficulty,
							reward_stage: REWARD_STAGE,
							song_id: SONG.id,
							audio_mode: audio.audioMode(),
							result_rank: rank,
							new_best: isNewBest,
							score_delta: g.score - (up.prevBestScore ?? 0), // 自己ベスト（更新前）との差。初回は score
							next_rank_need: goal.kind === 'rank' ? goal.need : 0,
							max_combo_new_best: up.isNewTopCombo,
							first_s_rank: up.isFirstS,
						});

						if (bestEl) bestEl.textContent = up.best.bestScore.toLocaleString('ja-JP');
						prepareResultShow(g, rank, up, goal);
						if (submitStatus) submitStatus.textContent = '';
						if (submitBtn) submitBtn.disabled = false;
						submitted = false;
						root.classList.remove('is-final');
						document.documentElement.classList.remove('cp-playing');
						// FINISH! と終止音を聞かせてから結果パネル（その間に次のゲームが始まったら出さない）
						const serial = gameSerial;
						window.setTimeout(() => {
							if (serial !== gameSerial) return;
							if (resultPanel) {
								resultPanel.hidden = false;
								// smooth にしない：iOS はスクロール中のタップを「スクロール停止」として扱い click が出ないため
								resultPanel.scrollIntoView({ behavior: 'auto', block: 'center' });
							}
							playResultShow(); // 結果発表（一瞬の無音 → 高速加算 → 各項目 → ランク → NEW BEST）
						}, RESULT_DELAY_MS);

						if (isNewBest) {
							trackGameEvent('personal_best', { score: g.score });
						}

						// 遊んだ難易度のランキングを表示
						rankDifficulty = currentDifficulty;
						setRankDiffTab(currentDifficulty);
						if (!rankingViewed) {
							rankingViewed = true;
							trackGameEvent('ranking_view', { period: currentPeriod, difficulty: rankDifficulty });
						}
						loadRanking(currentPeriod);

						document.dispatchEvent(
							new CustomEvent('chaospendulum:complete', {
								detail: { score: g.score, maxCombo: g.maxCombo },
							}),
						);
					}
				},
			});

			// --- 開始/リトライ：初回も retry も難易度変更も、必ずこの1経路を通す ---
			// user start → AudioContext.resume → transport 決定（拍0）→ BGM scheduler → カウントイン → engine.start
			let gameStarted = false;
			let starting = false;
			let startToken = 0;
			/**
			 * 盤面（HUD〜判定メッセージ）が画面からはみ出していたら全体が見える位置へ。ゲーム開始の「後」に呼ぶ。
			 * サイトのヘッダーは sticky なので、その高さぶん下げて HUD が隠れないようにする。
			 * behavior は 'auto'（スマホで smooth スクロール中のタップが握りつぶされる・開始処理と競合するのを避ける）。
			 */
			const revealGame = (behavior: ScrollBehavior = 'auto') => {
				const game = root.querySelector<HTMLElement>('.cp-game');
				if (!game) return;
				const headerH = document.querySelector('body > header')?.getBoundingClientRect().height ?? 0;
				const r = game.getBoundingClientRect();
				if (r.top < headerH || r.bottom > window.innerHeight) {
					const room = window.innerHeight - headerH;
					const offset = r.height <= room ? headerH + (room - r.height) / 2 : headerH + 4;
					window.scrollTo({ top: window.scrollY + r.top - offset, behavior });
				}
			};
			const startGame = async (retry = false) => {
				if (starting) return; // 開始処理中の連打は無視（1タップ = 1スタート）
				starting = true;
				const token = ++startToken;
				// タップした瞬間に反応が分かるように、結果パネルは待たずに隠す
				if (retry && resultPanel) resultPanel.hidden = true;
				try {
					// ユーザー操作の同期部分で resume を要求する。startTransport はどの状態でも有限時間で resolve し、
					// 音の時計が使えなければ performance 時計で返す（ここで止まらない）。念のため例外も握る。
					// 外部音源の初回はデコードに少しかかることがあるので、押したことが分かる表示に
					if (!retry && SONG.audio && startBtn) startBtn.textContent = `♪ ${SONG.title}  LOADING…`;
					await audio.startTransport(COUNTIN_BEATS, SONG);
				} catch {
					/* 音なしでもゲームは始める（audio.now() は performance 時計で進む） */
				} finally {
					starting = false;
					if (startBtn) startBtn.textContent = '▶ TAP TO START';
				}
				if (token !== startToken) return;
				handle.start({ difficulty: currentDifficulty, retry }); // gameTime<0 のカウントインから開始
				requestAnimationFrame(() => revealGame('auto')); // スクロールはゲーム開始の後に分離
				gameStarted = true;
				if (startOverlay) startOverlay.hidden = true;
				rankDifficulty = currentDifficulty;
				setRankDiffTab(currentDifficulty);
			};
			// オーバーレイ全体が TAP TO START（ボタンだけでなくどこを押しても開始）
			startOverlay?.addEventListener('click', () => void startGame(false));
			const isResultShown = () => !!resultPanel && !resultPanel.hidden;

			// ページ上部の ▶ PLAY から：ゲームを画面に入れて TAP TO START にフォーカスするだけ（ここでは開始しない）。
			// 開始（AudioContext の解除→transport→カウントイン）は、盤面を見た状態での TAP TO START に任せる。
			document.addEventListener('chaospendulum:focus', () => {
				const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
				revealGame(reduce ? 'auto' : 'smooth');
				const target = startOverlay && !startOverlay.hidden ? startBtn : isResultShown() ? againBtn : null;
				target?.focus({ preventScroll: true });
			});

			// --- 難易度の切り替え ---
			diffBtns.forEach((btn) =>
				btn.addEventListener('click', () => {
					const level = (btn.dataset.diff as Difficulty) ?? 'normal';
					if (level === currentDifficulty) return;
					currentDifficulty = level;
					diffBtns.forEach((b) => b.classList.toggle('active', b === btn));
					trackGameEvent('difficulty_change', { difficulty: level });
					rankDifficulty = level;
					setRankDiffTab(level);
					loadRanking(currentPeriod);
					if (gameStarted) void startGame(false); // 開始済みなら新難易度でやり直し（同じ start 経路）
				}),
			);

			// --- 「もう一回」：カウントインから再戦（ボタン or スペース/Enter） ---
			// click のみ（touch と二重登録しない）。開始処理中はボタンを無効にして 1タップ = 1スタート。
			againBtn?.addEventListener('click', async () => {
				if (againBtn.disabled) return;
				againBtn.disabled = true;
				try {
					await startGame(true);
				} finally {
					againBtn.disabled = false;
				}
			});
			window.addEventListener('keydown', (e) => {
				if (e.code !== 'Space' && e.code !== 'Enter') return;
				// 入力欄・ボタン・リンク・アコーディオンでは各要素の本来の動作を優先（ニックネームに空白を打てる／
				// ▶ PLAY を Enter で押しても開始はしない。TAP TO START 等のボタンは自分の click で動く）
				const el = e.target as HTMLElement | null;
				if (el?.closest?.('input, textarea, select, button, a, summary, [contenteditable="true"]')) return;
				// スタート前、または結果パネル表示中は、スペース/Enter で開始・再戦
				const retry = gameStarted && isResultShown();
				if (!gameStarted || retry) {
					e.preventDefault();
					void startGame(retry);
				}
			});

			// --- ランキング登録（希望したときだけ・自動送信しない） ---
			submitBtn?.addEventListener('click', async () => {
				if (!lastResult || submitted) return;
				// ランキングは内蔵曲のみ（外部音源のテスト曲は点の基準が違うので混ぜない）
				if (!IS_DEFAULT_SONG) {
					if (submitStatus) submitStatus.textContent = 'この曲はランキングの対象外です（テスト曲）';
					return;
				}
				const nickname = (nickInput?.value ?? '').trim() || '名無し';
				submitBtn.disabled = true;
				if (submitStatus) submitStatus.textContent = '登録中…';
				trackGameEvent('ranking_submit', { score: lastResult.score });
				try {
					// difficulty は lastResult に固定済み（プレイ時の難易度で送る）
					const res = await submitScore({ nickname, ...lastResult });
					submitted = true;
					if (submitStatus) submitStatus.textContent = `今日 ${res.rank}位`;
					trackGameEvent('ranking_submit_success', { score: lastResult.score, rank: res.rank });
					if (res.rank <= 10) audio.rankUp();
					loadRanking(currentPeriod);
				} catch {
					submitBtn.disabled = false;
					if (submitStatus)
						submitStatus.textContent = '登録に失敗しました。ゲーム結果は失われません。';
					trackGameEvent('ranking_submit_error', {});
				}
			});
		}
	}
</script>

