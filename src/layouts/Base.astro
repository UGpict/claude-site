---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ShareRail from '../components/ShareRail.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	ogImage?: string;
	shareTitle?: string;
}
const { title, description, image, ogImage, shareTitle } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={image} ogImage={ogImage} />
	</head>
	<body>
		<Header />
		<div class="layout">
			<aside class="rail rail-left">
				<ShareRail title={shareTitle ?? title} />
			</aside>
			<main class="content">
				<slot />
			</main>
			<aside class="rail rail-right">
				<Sidebar />
			</aside>
		</div>
		<Footer />
	</body>
</html>

<script>
	// スマホのシェアトーストを「下スクロール時だけ」表示する
	const rail = document.querySelector('.rail-left');
	if (rail) {
		let last = window.scrollY;
		let ticking = false;
		const update = () => {
			const y = window.scrollY;
			if (y > last + 4 && y > 220) {
				rail.classList.add('show'); // 下スクロール
			} else if (y < last - 4 || y < 140) {
				rail.classList.remove('show'); // 上スクロール、または最上部付近
			}
			last = y;
			ticking = false;
		};
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					window.requestAnimationFrame(update);
					ticking = true;
				}
			},
			{ passive: true },
		);
	}
</script>

<style>
	.layout {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr) 300px;
		gap: 2.5rem;
		width: min(1200px, 100% - 2em);
		margin: 0 auto;
		padding: 2rem 1em 4rem;
		align-items: start;
	}
	/* 共通シェルの main は列いっぱいに使う（global.css の main 幅指定を上書き） */
	main.content {
		width: auto;
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
	}
	.rail {
		position: sticky;
		top: 80px;
	}

	@media (max-width: 1100px) {
		.layout {
			grid-template-columns: 64px minmax(0, 1fr);
		}
		.rail-right {
			display: none;
		}
	}
	@media (max-width: 700px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			/* 下部の固定シェアバーに隠れないよう余白を確保 */
			padding: 1.25rem 1em calc(3rem + 64px);
		}
		/* 左シェアバーは画面下部に浮くトースト（ピル）として固定。
		   既定は隠し、下スクロール時だけ表示する（.show を付与） */
		.rail-left {
			position: fixed;
			top: auto;
			right: 0.75rem;
			bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
			left: 0.75rem;
			z-index: 60;
			transform: translateY(180%);
			opacity: 0;
			pointer-events: none;
			transition:
				transform 0.25s ease,
				opacity 0.25s ease;
		}
		.rail-left.show {
			transform: translateY(0);
			opacity: 1;
			pointer-events: auto;
		}
	}
</style>
