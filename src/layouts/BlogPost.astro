---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Base from './Base.astro';
import { AUTHOR_NAME, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, sponsored, headings, faq } =
	Astro.props;

// 目次には大見出し（H2）だけを載せ、番号は本文の節番号と一致させる
const tocItems = (headings ?? []).filter((h) => h.depth === 2);

// 構造化データ（記事）
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = heroImage
	? new URL(heroImage.src, Astro.site).toString()
	: undefined;
const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	...(imageUrl ? { image: imageUrl } : {}),
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: AUTHOR_NAME || SITE_TITLE },
	publisher: { '@type': 'Organization', name: SITE_TITLE },
	mainEntityOfPage: canonical,
	inLanguage: 'ja-JP',
};
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: '記事一覧', item: new URL('/blog/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: title, item: canonical },
	],
};
const faqSchema =
	faq && faq.length
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: faq.map((item) => ({
					'@type': 'Question',
					name: item.q,
					acceptedAnswer: { '@type': 'Answer', text: item.a },
				})),
			}
		: null;
---

<Base title={title} description={description} image={heroImage} shareTitle={title}>
	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
	{
		sponsored && (
			<p class="ad-disclosure">この記事はアフィリエイト広告（PR）を含みます。</p>
		)
	}
	<article>
		<div class="hero-image">
			{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>
						)
					}
				</div>
				<h1>{title}</h1>
			</div>

			{
				tocItems.length > 1 && (
					<nav class="toc" aria-label="目次">
						<p class="toc-title">目次</p>
						<ol>
							{tocItems.map((h) => (
								<li>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<div class="body">
				<slot />
			</div>
		</div>
	</article>
</Base>

<style>
	.ad-disclosure {
		margin: 0 auto 1.5em;
		max-width: 720px;
		padding: 0.6em 1em;
		font-size: 0.85rem;
		color: #333333;
		background: rgb(var(--gray-light));
		border-radius: 8px;
	}
	.hero-image {
		width: 100%;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.prose {
		width: 720px;
		max-width: 100%;
		margin: auto;
		padding: 1em 0;
	}
	.title {
		margin-bottom: 1.5em;
		padding: 1em 0 0.5em;
		text-align: center;
		line-height: 1.25;
	}
	.title h1 {
		font-size: 1.95rem;
		margin: 0 0 0.4em 0;
	}
	.date {
		margin-bottom: 0.5em;
		color: rgb(var(--gray));
	}
	.last-updated-on {
		font-style: italic;
	}

	/* 目次（概要）— クリックで各節へジャンプ */
	.toc {
		background: #fbfbfa;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1.1rem 1.4rem 1.2rem;
		margin: 0 0 2.5rem;
	}
	.toc-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: #333333;
		margin: 0 0 0.6rem;
	}
	.toc ol {
		margin: 0;
		padding-left: 1.4rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.toc li {
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.toc a {
		color: #333333;
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	/* 本文タイポグラフィ（note 風） */
	.body {
		font-size: 18px;
		line-height: 1.9;
		color: #333333;
	}
	/* 節番号（H2 を 1,2,3… と自動採番。目次の番号と一致） */
	.body {
		counter-reset: section;
	}
	.body :global(h2) {
		counter-increment: section;
		font-size: 1.45em;
		line-height: 1.4;
		margin: 2.2em 0 0.8em;
		padding-bottom: 0.3em;
		border-bottom: 2px solid rgb(var(--gray-light));
		scroll-margin-top: 84px;
	}
	.body :global(h2)::before {
		content: counter(section) '. ';
		color: var(--accent);
		font-weight: 700;
	}
	.body :global(h3) {
		font-size: 1.2em;
		line-height: 1.45;
		margin: 1.8em 0 0.6em;
		scroll-margin-top: 84px;
	}
	.body :global(p) {
		margin: 0 0 1.4em;
	}
	.body :global(ul),
	.body :global(ol) {
		margin: 0 0 1.4em;
		padding-left: 1.4em;
	}
	.body :global(li) {
		margin-bottom: 0.4em;
	}
	.body :global(img) {
		margin: 1.5em auto;
		border: 1px solid rgb(var(--gray-light));
	}
	.body :global(blockquote) {
		font-size: 1em;
		color: #555555;
	}
	.body :global(table) {
		font-size: 0.95em;
	}

	/* 薄い黄色のマーカー（そこだけ読めば要点が分かる） */
	.body :global(mark) {
		background: linear-gradient(transparent 60%, #fff3a3 60%);
		padding: 0 0.06em;
		color: inherit;
	}

	@media (max-width: 720px) {
		.body {
			font-size: 17px;
			line-height: 1.85;
		}
		.title h1 {
			font-size: 1.6rem;
		}
		/* 広い表は横スクロールで溢れさせない */
		.body :global(table) {
			display: block;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
		}
	}
</style>
